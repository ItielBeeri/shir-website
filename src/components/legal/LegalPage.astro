---
/**
 * LegalPage - shared renderer for the site's legal documents
 * (הצהרת נגישות, תנאי שימוש ומדיניות פרטיות).
 *
 * A dumb renderer, per AGENTS.md §6: it holds no Hebrew copy of its own -
 * everything comes from src/content/pages/*.toml so the owner can edit the
 * wording without touching code.
 *
 * Two document shapes are supported, because the two documents genuinely
 * differ: the accessibility statement is one flat run of sections, while the
 * terms/privacy document is two named parts each holding its own sections.
 * A document may use either, or both.
 *
 * Heading levels: h1 (page title) → h2 (part heading) → h3 (section title).
 * When a document has no parts, sections render at h2 so the hierarchy stays
 * contiguous with no skipped level (WCAG 2.0 SC 1.3.1).
 */


export interface LegalSection {
  title: string;
  body?: string[];
  items?: string[];
}

export interface LegalPart {
  heading: string;
  sections: LegalSection[];
}

interface Props {
  /** Optional eyebrow above the title. */
  kicker?: string;
  title: string;
  /** ISO date (YYYY-MM-DD) of the last substantive update. */
  updated: string;
  updatedLabel: string;
  intro?: string;
  sections?: LegalSection[];
  parts?: LegalPart[];
}

const { kicker, title, updated, updatedLabel, intro, sections = [], parts = [] } = Astro.props;

/** Western digits, as the site requires - dd.mm.yyyy. */
const updatedDisplay = new Date(updated).toLocaleDateString('he-IL', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

/** Stable, collision-free ids for the in-page table of contents. */
const slug = (value: string, prefix: string, index: number) =>
  `${prefix}-${index}-${value.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '')}`;

const partIds = parts.map((part, i) => slug(part.heading, 'part', i));
const flatIds = sections.map((section, i) => slug(section.title, 'section', i));

const hasToc = parts.length > 0 || sections.length > 3;
---

<article class="legal container">
  <div class="legal-header">
    {kicker && <p class="text-kicker">{kicker}</p>}
    <h1 class="legal-title">{title}</h1>
    <p class="legal-updated">
      {updatedLabel}: <time datetime={updated}>{updatedDisplay}</time>
    </p>
  </div>

  {intro && <p class="legal-intro">{intro.trim()}</p>}

  {hasToc && (
    <nav class="legal-toc" aria-label="תוכן העניינים">
      <h2 class="legal-toc-title">תוכן העניינים</h2>
      <ul>
        {parts.map((part, i) => (
          <li><a href={`#${partIds[i]}`} class="link-underline">{part.heading}</a></li>
        ))}
        {sections.map((section, i) => (
          <li><a href={`#${flatIds[i]}`} class="link-underline">{section.title}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {/* Flat documents: sections sit directly under the h1, so they are h2. */}
  {sections.map((section, i) => (
    <section class="legal-section" aria-labelledby={flatIds[i]}>
      <h2 id={flatIds[i]} class="legal-section-title">{section.title}</h2>
      {section.body?.map((paragraph) => <p class="legal-paragraph">{paragraph}</p>)}
      {section.items && (
        <ul class="legal-list">
          {section.items.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </section>
  ))}

  {/* Parted documents: part heading is h2, its sections are h3. */}
  {parts.map((part, i) => (
    <section class="legal-part" aria-labelledby={partIds[i]}>
      <h2 id={partIds[i]} class="legal-part-title">{part.heading}</h2>
      {part.sections.map((section, j) => {
        const id = `${partIds[i]}--${j}`;
        return (
          <div class="legal-section">
            <h3 id={id} class="legal-section-title">{section.title}</h3>
            {section.body?.map((paragraph) => <p class="legal-paragraph">{paragraph}</p>)}
            {section.items && (
              <ul class="legal-list">
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
        );
      })}
    </section>
  ))}

  {/* Page-specific tail content - e.g. the accessibility contact block. */}
  <slot />
</article>

<style>
  .legal {
    /* A legal document is read, not scanned - hold the line length down. */
    max-inline-size: 74ch;
    padding-block: clamp(2rem, 5vh, 4rem) var(--space-section);
  }

  .legal-header { margin-block-end: var(--space-block); }

  .legal-title {
    font-size: var(--fs-h1);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 0.25rem 0.5rem;
  }

  .legal-updated {
    font-size: var(--fs-small);
    color: var(--color-mist);
  }

  .legal-intro {
    font-size: var(--fs-h3);
    font-weight: 300;
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    white-space: pre-line;
    margin-block-end: var(--space-block);
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--accent, var(--color-teal));
  }

  .legal-toc {
    margin-block-end: var(--space-section);
    padding: 1.25rem 1.5rem;
    background: var(--color-glass);
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
  }

  .legal-toc-title {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  .legal-toc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legal-toc a {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }
  .legal-toc a:hover { color: var(--color-ink); }

  .legal-part { padding-block: 0 var(--space-block); }

  .legal-part-title {
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: var(--space-block) 1rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--color-glass-stroke);
  }

  .legal-section { padding-block: 0 1.75rem; }

  .legal-section-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink);
    margin-block-end: 0.6rem;
  }

  .legal-paragraph {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    margin-block-end: 0.75rem;
  }

  .legal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block: 0.25rem 0.75rem;
  }

  .legal-list li {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
  }

  .legal-list li::before {
    content: '·';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent, var(--color-teal));
    font-weight: 700;
  }

  /* Anchor targets sit under the sticky header without the offset. */
  .legal-section-title,
  .legal-part-title {
    scroll-margin-block-start: 88px;
  }
</style>
