---
/**
 * No View Transitions here, deliberately: Astro's bundled module scripts run
 * once and are not re-run on a view-transition swap, so Lenis, GSAP and
 * ScrollTrigger end up holding stale DOM references after a Back navigation.
 * Full-page navigation re-runs every script and keeps native scroll restoration.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BackgroundField from './BackgroundField.astro';
import ConsentBanner from './ConsentBanner.astro';
import { loadToml } from '../../lib/content';
import { z } from 'zod';
import { SITE_URL } from '../../lib/seo';

/*
 * global.css is inlined rather than linked. It is render-blocking, and
 * everything in public/ is served `max-age=0, must-revalidate` because those
 * URLs are author-named and mutable - so every navigation, cold or repeat,
 * paid a round trip (~250ms for an empty 304) before first paint.
 *
 * Caching it harder is not the alternative: on a stable URL a long max-age
 * means an edit never reaches anyone who has already visited. Content hashing
 * solves that, and public/ deliberately does not hash - this is the file a
 * non-developer edits by name.
 */
const globalCss = readFileSync(resolve(process.cwd(), 'public/global.css'), 'utf-8');

const analyticsSchema = z.object({
  analytics: z.object({
    enabled:        z.boolean(),
    measurement_id: z.string(),
  }),
});

/*
 * The measurement id reaches the client as a body attribute rather than an
 * inlined script, so the consent gate stays an ordinary bundled module. It is
 * not a secret - it is readable in any page's source by design - and its
 * absence is what tells the gate there is nothing to load.
 */
const { analytics } = loadToml('site.toml', analyticsSchema);
const gaId = analytics.enabled ? analytics.measurement_id : undefined;

interface Props {
  title: string;
  description: string;
  theme?: 'default' | 'psychotherapy' | 'shiatsu' | 'voice' | 'workshops' | 'ceremonies';
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  theme = 'default',
  canonical,
  ogImage = '/img/og-default.jpg',
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const pageTitle = title.includes('שיר אמיתי') ? title : `${title} | שיר אמיתי`;
---

<!doctype html>
<html lang="he" dir="rtl" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="language" content="Hebrew" />

    <!-- Must run before first paint: hands [data-reveal] over to JS (without
         JS, .no-js keeps it visible - see global.css), and restores the
         visitor's "stop animations" choice before anything can animate. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          if (localStorage.getItem('shir:motion') === 'off') {
            d.setAttribute('data-motion', 'off');
          }
        } catch (e) {
          /* storage blocked - motion stays on */
        }
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE_URL).href} />

    <link rel="alternate" hreflang="he" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- The only downloaded face; body text uses the visitor's system font.
         No preconnect - nothing comes from a third-party origin. -->
    <link
      rel="preload"
      href="/fonts/heebo-hebrew.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- `is:inline` keeps Astro from bundling, scoping or minifying this, and
         keeps it ahead of the component styles Astro injects below - the
         source order the cascade in global.css assumes. -->
    <style is:inline set:html={globalCss}></style>

    <slot name="head" />
  </head>

  <body data-theme={theme} data-ga={gaId}>
    <a class="skip-link" href="#main">דלג לתוכן</a>

    {/* Second in tab order, so the question is reachable before the page. */}
    {gaId && <ConsentBanner />}

    <BackgroundField />

    <slot />

    <script>
      import '@/scripts/lenis-init';
    </script>
    <script>
      import '@/scripts/scroll-reveal';
    </script>
    <!--
      Page counting, ungated. It sets no persistent identifier and introduces
      no new recipient - the host already sees every request - so it does not
      rest on consent, and it therefore counts everyone rather than only the
      visitors who accept GA. `is:inline` because the path is served by the
      platform and does not exist at build time; it 404s under `pnpm preview`,
      which is expected.
    -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>

    <script>
      import '@/scripts/analytics';
    </script>
    <script>
      import '@/scripts/parallax';
    </script>
  </body>
</html>
