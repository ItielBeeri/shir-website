---
/**
 * The in-page mechanism SC 2.2.2 (ת"י 5568 חלק 1) requires for the animations
 * that loop indefinitely - background drift, breath dividers, hero rules.
 * `prefers-reduced-motion` alone does not satisfy it: the criterion asks for a
 * control *in the page*.
 *
 * State lives on <html data-motion>, persisted in localStorage and restored
 * before first paint by the inline script in BaseLayout.
 */
---

<button
  type="button"
  class="motion-toggle"
  id="motion-toggle"
  aria-pressed="false"
>
  <span class="motion-toggle-icon" aria-hidden="true"></span>
  <span class="motion-toggle-label" data-label-on="עצירת אנימציות" data-label-off="הפעלת אנימציות"
    >עצירת אנימציות</span
  >
</button>

<style>
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    padding: 0.5rem 0;
    min-block-size: 44px;
    color: var(--color-mist);
    font-size: var(--fs-small);
    cursor: pointer;
    transition: color var(--dur-fast);
  }
  .motion-toggle:hover { color: var(--color-ink-soft); }
  .motion-toggle:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Filled when motion is on, hollow when paused - supporting only; the
     label carries the meaning, since shape alone cannot (SC 1.4.1). */
  .motion-toggle-icon {
    inline-size: 12px;
    block-size: 12px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: currentColor;
    flex-shrink: 0;
  }
  .motion-toggle[aria-pressed='true'] .motion-toggle-icon {
    background: transparent;
  }
</style>

<script>
  import { track } from '@/scripts/analytics';

  const KEY = 'shir:motion';
  const root = document.documentElement;
  const btn = document.getElementById('motion-toggle');
  const label = btn?.querySelector<HTMLElement>('.motion-toggle-label');

  /** Pressed means animations stopped. */
  const sync = () => {
    const off = root.getAttribute('data-motion') === 'off';
    btn?.setAttribute('aria-pressed', String(off));
    if (label) {
      label.textContent = off
        ? (label.dataset.labelOff ?? 'הפעלת אנימציות')
        : (label.dataset.labelOn ?? 'עצירת אנימציות');
    }
  };

  btn?.addEventListener('click', () => {
    const off = root.getAttribute('data-motion') === 'off';
    if (off) {
      root.removeAttribute('data-motion');
    } else {
      root.setAttribute('data-motion', 'off');
    }
    try {
      localStorage.setItem(KEY, off ? 'on' : 'off');
    } catch (e) {
      /* storage blocked - the choice still holds for this page view */
    }
    sync();
    /* Tracked here rather than via data-an-*, because the value worth
       recording is the state being moved to, which only this scope knows. */
    track('motion_toggle', { state: off ? 'on' : 'off' });
  });

  sync();
</script>
