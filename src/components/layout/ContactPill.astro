---
/**
 * ContactPill — persistent floating CTA.
 * Position: bottom-inline-start (bottom-right in RTL), 24px from edges.
 * Collapsed: single WhatsApp icon (~52px).
 * Expanded on hover/focus: three buttons — WhatsApp (primary), phone (secondary), email (tertiary).
 * Hidden when within 200px of footer.
 */
import { loadToml } from '../../lib/content';
import { z } from 'zod';
import Icon from '../ui/Icon.astro';

const siteSchema = z.object({
  contact: z.object({
    whatsapp_url:   z.string(),
    whatsapp_label: z.string(),
    phone_href:     z.string(),
    phone_display:  z.string(),
    phone_label:    z.string(),
    email_href:     z.string(),
    email_label:    z.string(),
  }),
});

const { contact } = loadToml('site.toml', siteSchema);
---

<div
  class="contact-pill"
  id="contact-pill"
  role="complementary"
  aria-label="כפתורי יצירת קשר מהירה"
>
  <!-- Expanded actions -->
  <div class="pill-actions" id="pill-actions">
    <!-- 1. WhatsApp — primary (§5.4 order) -->
    <a
      href={contact.whatsapp_url}
      target="_blank"
      rel="noopener"
      class="pill-btn pill-primary"
      aria-label={`${contact.whatsapp_label} — נפתח בטאב חדש`}
    >
      <Icon name="whatsapp" decorative size={22} />
    </a>
    <!-- 2. Phone — secondary -->
    <a
      href={contact.phone_href}
      class="pill-btn pill-secondary"
      aria-label={contact.phone_label}
    >
      <Icon name="phone" decorative size={20} />
    </a>
    <!-- 3. Email — tertiary -->
    <a
      href={`mailto:${contact.email_href.replace('mailto:', '')}`}
      class="pill-btn pill-tertiary"
      aria-label={contact.email_label}
    >
      <Icon name="mail" decorative size={18} />
    </a>
  </div>

  <!-- Main trigger — always visible, shows WhatsApp icon -->
  <a
    href={contact.whatsapp_url}
    target="_blank"
    rel="noopener"
    class="pill-trigger"
    aria-label={`${contact.whatsapp_label} — נפתח בטאב חדש`}
  >
    <svg class="pill-wa-icon" viewBox="0 0 24 24" width="26" height="26" fill="#25D366" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>


<script>
  // Hide pill near footer
  const pill = document.getElementById('contact-pill');
  const footer = document.querySelector('footer');

  if (footer && pill) {
    const observer = new IntersectionObserver(
      ([entry]) => { pill.classList.toggle('hidden', entry.isIntersecting); },
      { rootMargin: '200px 0px 0px 0px' },
    );
    observer.observe(footer);
  }
</script>
