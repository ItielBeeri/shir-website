---
/**
 * Header — sticky, transparent, becomes frosted glass on scroll.
 * RTL: logo on the right (inline-start), nav on the left (inline-end).
 * Data-driven from nav.toml. All items are flat top-level links.
 */
import { loadToml } from '../../lib/content';
import { z } from 'zod';
import Icon from '../ui/Icon.astro';

const navItemSchema = z.object({
  label: z.string(),
  href:  z.string(),
  theme: z.string().optional(),
});

const navSchema = z.object({
  items: z.array(navItemSchema),
});

const nav = loadToml('nav.toml', navSchema);
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <!-- Logo / wordmark — inline-start (right in RTL) -->
    <a href="/" class="wordmark" aria-label="שיר אמיתי — לדף הבית">
      שיר אמיתי
    </a>

    <!-- Desktop nav — inline-end (left in RTL) -->
    <nav class="desktop-nav" aria-label="ניווט ראשי">
      <ul role="list">
        {nav.items.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile hamburger button -->
    <button
      class="hamburger hit-target"
      id="mobile-menu-btn"
      aria-label="פתיחת תפריט ניווט"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <Icon name="menu" decorative size={22} />
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div
  class="mobile-drawer glass"
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="תפריט ניווט"
  data-open="false"
>
  <button
    class="drawer-close hit-target"
    id="drawer-close-btn"
    aria-label="סגירת תפריט"
  >
    <Icon name="close" decorative size={22} />
  </button>

  <nav aria-label="ניווט ראשי — נייד">
    <ul role="list" class="drawer-nav">
      {nav.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="drawer-link"
            aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
            data-reveal
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<!-- Overlay backdrop -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    block-size: 72px;
    display: flex;
    align-items: center;
    transition:
      background var(--dur-base) var(--ease-soft),
      backdrop-filter var(--dur-base) var(--ease-soft);
  }

  .site-header.scrolled {
    background: rgba(253, 250, 244, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--color-glass-stroke);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
  }

  /* Wordmark */
  .wordmark {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: opacity var(--dur-fast) var(--ease-soft);
    flex-shrink: 0;
  }
  .wordmark:hover { opacity: 0.7; }

  /* Desktop nav */
  .desktop-nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--color-ink-soft);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-soft), background var(--dur-fast) var(--ease-soft);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.35);
  }
  .nav-link[aria-current="page"] { font-weight: 600; }

  /* Hamburger — hidden on desktop */
  .hamburger { display: none; }

  /* Mobile drawer */
  .mobile-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(320px, 85vw);
    z-index: 200;
    padding: 2rem 1.5rem;
    display: none;
    flex-direction: column;
    gap: 1rem;
    transform: translateX(calc(var(--dir-x) * -100%));
    transition: transform var(--dur-base) var(--ease-soft);
  }
  .mobile-drawer[data-open="true"] { transform: translateX(0); }

  .drawer-close {
    align-self: flex-end;
    background: transparent;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
  }

  .drawer-nav { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }

  .drawer-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--color-ink);
    transition: background var(--dur-fast);
  }
  .drawer-link:hover,
  .drawer-link[aria-current="page"] { background: rgba(255, 255, 255, 0.4); }

  /* Backdrop */
  .drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 190;
    background: rgba(34, 51, 42, 0.25);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-soft);
  }
  .drawer-backdrop.visible {
    display: block;
    opacity: 1;
  }

  /* Mobile breakpoint */
  @media (max-width: 767px) {
    .site-header { block-size: 56px; }
    .desktop-nav { display: none; }
    .hamburger { display: flex; }
    .mobile-drawer { display: flex; }
  }
</style>

<script>
  // Scroll → frosted glass
  const header = document.getElementById('site-header');
  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 80);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile drawer
  const btn      = document.getElementById('mobile-menu-btn');
  const drawer   = document.getElementById('mobile-drawer');
  const closeBtn = document.getElementById('drawer-close-btn');
  const backdrop = document.getElementById('drawer-backdrop');

  const openDrawer = () => {
    drawer?.setAttribute('data-open', 'true');
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'סגירת תפריט ניווט');
    backdrop?.classList.add('visible');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  };

  const closeDrawer = () => {
    drawer?.setAttribute('data-open', 'false');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'פתיחת תפריט ניווט');
    backdrop?.classList.remove('visible');
    document.body.style.overflow = '';
    btn?.focus();
  };

  btn?.addEventListener('click', () => {
    drawer?.getAttribute('data-open') === 'true' ? closeDrawer() : openDrawer();
  });
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
