---
/**
 * Header - sticky, transparent, becomes frosted glass on scroll.
 * RTL: logo on the right (inline-start), nav on the left (inline-end).
 * Data-driven from nav.toml. All items are flat top-level links.
 */
import { loadToml } from '../../lib/content';
import { z } from 'zod';

const navItemSchema = z.object({
  label: z.string(),
  href:  z.string(),
  theme: z.string().optional(),
});

const navSchema = z.object({
  items: z.array(navItemSchema),
});

const nav = loadToml('nav.toml', navSchema);
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header" data-home-morph={Astro.url.pathname === '/' ? 'true' : undefined}>
  <div class="header-bg" aria-hidden="true"></div>
  <div class="header-inner container">
    <!-- Logo / wordmark - inline-start (right in RTL).
         On the home page, it stays invisible until the hero scrolls away;
         a morph animation transforms the hero title into this slot. -->
    <a
      href="/"
      class="wordmark"
      id="header-wordmark"
      aria-label="שיר אמיתי - לדף הבית"
      tabindex={Astro.url.pathname === '/' ? '-1' : undefined}
      aria-hidden={Astro.url.pathname === '/' ? 'true' : undefined}
    >
      שיר אמיתי
    </a>

    <!-- Desktop nav - inline-end (left in RTL) -->
    <nav class="desktop-nav" aria-label="ניווט ראשי">
      <ul role="list">
        {nav.items.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- Mobile hamburger button - sibling of <header> so it escapes the header's
     stacking context and can float above the drawer. Visible on mobile only. -->
<button
  class="hamburger hit-target"
  id="mobile-menu-btn"
  aria-label="פתיחת תפריט ניווט"
  aria-expanded="false"
  aria-controls="mobile-drawer"
>
  <span class="hamburger-icon" aria-hidden="true">
    <span class="bar bar-top"></span>
    <span class="bar bar-mid"></span>
    <span class="bar bar-bot"></span>
  </span>
</button>

<!-- Mobile drawer -->
<div
  class="mobile-drawer glass"
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="תפריט ניווט"
  data-open="false"
  inert
>
  <nav aria-label="ניווט ראשי - נייד">
    <ul role="list" class="drawer-nav">
      <!-- Site title / home link - first item, anchors the drawer -->
      <li class="drawer-home-item">
        <a
          href="/"
          class="drawer-home-link"
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          שיר אמיתי
        </a>
      </li>

      {nav.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="drawer-link"
            aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
            data-reveal
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<!-- Overlay backdrop -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    block-size: 72px;
    display: flex;
    align-items: center;
    isolation: isolate;
    /* No transition here - avoids backdrop-filter jank.
       The .header-bg layer fades via opacity instead. */
  }

  /* Frosted-glass background as a separate layer so we can animate
     opacity (cheap, GPU-composited) instead of backdrop-filter
     (expensive, causes the visible "vibration" during scroll). */
  .header-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(253, 250, 244, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--color-glass-stroke);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-soft);
    /* Promote to own compositor layer so opacity changes don't
       trigger relayout/repaint of the header content. */
    will-change: opacity;
    contain: layout paint;
  }

  .site-header.scrolled .header-bg {
    opacity: 1;
  }

  /* On home page, inline styles from the morph script drive opacity directly;
     CSS transitions would fight with the scrub, so disable them. */
  .site-header[data-home-morph] .header-bg {
    transition: none;
  }

  /* On the home page, the header wordmark visibility is controlled
     entirely by the morph script via inline styles.
     The CSS below is only a no-JS / reduced-motion safety net. */
  .site-header[data-home-morph] .wordmark {
    opacity: 0;
    pointer-events: none;
  }
  .site-header[data-home-morph].scrolled .wordmark {
    opacity: 1;
    pointer-events: auto;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
  }

  /* Wordmark */
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .wordmark:hover { opacity: 0.7; }

  /* Desktop nav */
  .desktop-nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--color-ink-soft);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-soft), background var(--dur-fast) var(--ease-soft);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.35);
  }
  .nav-link[aria-current="page"] { font-weight: 600; }

  /* Hamburger - top-level sibling of <header>, hidden on desktop.
     On mobile: position: fixed in top-left (RTL: inline-end) corner at z-index 300,
     so it floats above the drawer (200) and backdrop (190). */
  .hamburger {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .hamburger:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Animated hamburger icon - three bars morph into × */
  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 22px;
    height: 22px;
    gap: 0;
    position: relative;
  }

  .bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    position: absolute;
    transition:
      transform var(--dur-base) var(--ease-soft),
      opacity   var(--dur-fast) var(--ease-soft);
  }

  .bar-top { transform: translateY(-6px); }
  .bar-mid { transform: translateY(0); }
  .bar-bot { transform: translateY(6px); }

  /* Open state - bars rotate into × */
  .hamburger[aria-expanded="true"] .bar-top {
    transform: translateY(0) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] .bar-bot {
    transform: translateY(0) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { transition: none; }
  }

  /* Mobile drawer - always in DOM, off-screen by default via transform.
     Anchored to inline-end (left edge in RTL) - same side as the hamburger button.
     Slides in from the left so it feels connected to the tap target. */
  .mobile-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;          /* left edge in RTL */
    inline-size: min(320px, 85vw);
    z-index: 200;
    /* Top padding clears the fixed hamburger button (56px) + breathing room */
    padding: calc(56px + 1rem) 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* Sharp corners on the screen edge (inline-end = left in RTL),
       rounded on the exposed interior side (inline-start = right in RTL).
       Overrides the uniform border-radius from .glass utility. */
    border-start-start-radius: var(--radius-card);  /* top-right in RTL */
    border-end-start-radius:   var(--radius-card);  /* bottom-right in RTL */
    border-start-end-radius:   0;                   /* top-left in RTL - flush to screen */
    border-end-end-radius:     0;                   /* bottom-left in RTL - flush to screen */
    /* Push off-screen to the left (negative X) when closed */
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-end;
  }
  .mobile-drawer[data-open="true"] {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-start;
  }

  .drawer-nav { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }

  .drawer-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--color-ink);
    transition: background var(--dur-fast);
  }
  .drawer-link:hover,
  .drawer-link[aria-current="page"] { background: rgba(255, 255, 255, 0.4); }

  /* Site title - home link at the top of the drawer */
  .drawer-home-item {
    margin-block-end: 0.5rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-glass-stroke);
  }

  .drawer-home-link {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: background var(--dur-fast);
  }
  .drawer-home-link:hover,
  .drawer-home-link[aria-current="page"] { background: rgba(255, 255, 255, 0.4); }

  /* Backdrop */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 190;
    background: rgba(34, 51, 42, 0.25);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-end;
  }
  .drawer-backdrop.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-start;
  }

  /* Mobile breakpoint */
  @media (max-width: 767px) {
    .site-header { block-size: 56px; }
    .desktop-nav { display: none; }

    /* Fix the hamburger independently so it floats above the drawer.
       Pinned to the same corner as the drawer (inline-end = left in RTL). */
    .hamburger {
      display: flex;
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: 0;
      block-size: 56px;
      z-index: 300; /* above drawer (200) and backdrop (190) */
      padding-inline: 1.25rem;
    }
  }

  /* Desktop: hide drawer entirely */
  @media (min-width: 768px) {
    .mobile-drawer,
    .drawer-backdrop { display: none !important; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const header = document.getElementById('site-header') as HTMLElement | null;
  const headerBg = header?.querySelector<HTMLElement>('.header-bg');
  const wordmark = document.getElementById('header-wordmark') as HTMLElement | null;
  const isHome = header?.dataset.homeMorph === 'true';
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * On the home page the wordmark fades in as the hero scrolls away. While it
   * is invisible it must not be reachable by keyboard or exposed to screen
   * readers - an invisible-but-focusable link fails SC 2.4.7 (Focus Visible),
   * because the focus ring lands on nothing the user can see.
   */
  const setWordmarkHidden = (hidden: boolean) => {
    if (!wordmark || !isHome) return;
    if (hidden) {
      wordmark.setAttribute('tabindex', '-1');
      wordmark.setAttribute('aria-hidden', 'true');
    } else {
      wordmark.removeAttribute('tabindex');
      wordmark.removeAttribute('aria-hidden');
    }
  };

  // --- Non-home pages: IntersectionObserver-based "scrolled" toggle ---
  if (header && !isHome) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:80px;left:0;width:1px;height:1px;pointer-events:none;';
    document.body.prepend(sentinel);

    const io = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { rootMargin: '0px' },
    );
    io.observe(sentinel);
  }

  // --- Home page: hero title scrolls naturally; header wordmark appears
  //     once hero exits viewport, with a scale-down entrance animation
  //     that gives the impression of the hero title "becoming" the header. ---
  if (header && wordmark && headerBg && isHome) {
    const hero = document.querySelector<HTMLElement>('.hero');

    if (hero) {
      if (prefersReducedMotion) {
        const io = new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('scrolled', !entry.isIntersecting);
            setWordmarkHidden(entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(hero);
      } else {
        // Use ScrollTrigger to track hero exit progress.
        // The header bg + wordmark appear as the hero scrolls out.
        ScrollTrigger.getById('header-morph')?.kill();

        ScrollTrigger.create({
          id: 'header-morph',
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          onUpdate: (self) => {
            const p = self.progress;

            // Header bg: fade in from 60% to 100% of hero scroll
            const bgFade = gsap.utils.clamp(0, 1, (p - 0.6) / 0.4);
            headerBg!.style.opacity = String(bgFade);

            // Wordmark: appear from 50%, scale from 1.8 → 1
            const wordmarkProgress = gsap.utils.clamp(0, 1, (p - 0.5) / 0.5);
            const scale = gsap.utils.interpolate(1.8, 1, wordmarkProgress);
            const opacity = wordmarkProgress;

            wordmark!.style.opacity = String(opacity);
            wordmark!.style.transform = wordmarkProgress < 1 ? `scale(${scale})` : '';
            wordmark!.style.transformOrigin = 'center center';

            // Reachable only once it is actually legible.
            setWordmarkHidden(opacity < 0.5);
          },
          onLeave: () => {
            // Fully scrolled past hero - clean final state
            wordmark!.style.opacity = '';
            wordmark!.style.transform = '';
            headerBg!.style.opacity = '';
            header.classList.add('scrolled');
            setWordmarkHidden(false);
          },
          onEnterBack: () => {
            // Re-entering hero zone - remove scrolled, script takes over
            header.classList.remove('scrolled');
          },
          onLeaveBack: () => {
            // Back at top - wordmark hidden
            wordmark!.style.opacity = '0';
            wordmark!.style.transform = 'scale(1.8)';
            headerBg!.style.opacity = '0';
            header.classList.remove('scrolled');
            setWordmarkHidden(true);
          },
        });
      }
    }
  }

  // --- Mobile drawer ---
  const btn      = document.getElementById('mobile-menu-btn');
  const drawer   = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  const isOpen = () => drawer?.getAttribute('data-open') === 'true';

  /** Focusable descendants of the drawer, in DOM order. */
  const drawerFocusables = () =>
    Array.from(
      drawer?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? [],
    ).filter((el) => el.offsetParent !== null);

  const openDrawer = () => {
    drawer?.removeAttribute('inert');
    drawer?.setAttribute('data-open', 'true');
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'סגירת תפריט ניווט');
    backdrop?.classList.add('visible');
    document.body.style.overflow = 'hidden';
    // Move focus into the dialog so keyboard and screen-reader users land
    // inside it rather than continuing through the page behind (SC 2.4.3).
    drawerFocusables()[0]?.focus();
  };

  const closeDrawer = () => {
    drawer?.setAttribute('inert', '');
    drawer?.setAttribute('data-open', 'false');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'פתיחת תפריט ניווט');
    backdrop?.classList.remove('visible');
    document.body.style.overflow = '';
  };

  /** Close and return focus to the control that opened it. */
  const dismissDrawer = () => {
    closeDrawer();
    btn?.focus();
  };

  btn?.addEventListener('click', () => {
    isOpen() ? dismissDrawer() : openDrawer();
  });
  backdrop?.addEventListener('click', dismissDrawer);

  // Following a link navigates away - close without stealing focus.
  drawer?.querySelectorAll('.drawer-link, .drawer-home-link').forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', (e) => {
    // Only act when the drawer is actually open. Previously every Escape
    // anywhere on the site yanked focus to the hamburger button.
    if (!isOpen()) return;

    if (e.key === 'Escape') {
      dismissDrawer();
      return;
    }

    // aria-modal="true" promises focus stays inside the dialog; the hamburger
    // (which closes it) counts as part of that group since it floats above.
    if (e.key === 'Tab') {
      const items = drawerFocusables();
      if (btn) items.push(btn);
      if (items.length === 0) return;

      const first = items[0];
      const last  = items[items.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
