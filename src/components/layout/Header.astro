---
/** Sticky header, frosted on scroll. Items come from nav.toml. */
import { loadToml } from '../../lib/content';
import { z } from 'zod';

const navItemSchema = z.object({
  label:  z.string(),
  href:   z.string(),
  theme:  z.string().optional(),
  header: z.boolean().default(true),
});

const navSchema = z.object({
  items: z.array(navItemSchema),
});

// header = false marks an item footer-only.
const nav = loadToml('nav.toml', navSchema);
const headerItems = nav.items.filter((item) => item.header);
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header" data-home-morph={Astro.url.pathname === '/' ? 'true' : undefined}>
  <div class="header-bg" aria-hidden="true"></div>
  <div class="header-inner container">
    <!-- On the home page this starts hidden: the morph script fades it in as
         the hero title scrolls away into this slot. -->
    <a
      href="/"
      class="wordmark"
      id="header-wordmark"
      aria-label="שיר אמיתי - לדף הבית"
      tabindex={Astro.url.pathname === '/' ? '-1' : undefined}
      aria-hidden={Astro.url.pathname === '/' ? 'true' : undefined}
    >
      שיר אמיתי
    </a>

    <nav class="desktop-nav" aria-label="ניווט ראשי">
      <ul role="list">
        {headerItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
              data-an-event="nav_click"
              data-an-cta-label={item.label}
              data-an-placement="header"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- A sibling of <header>, not a child: it must escape the header's stacking
     context to float above the drawer. -->
<button
  class="hamburger hit-target"
  id="mobile-menu-btn"
  aria-label="פתיחת תפריט ניווט"
  aria-expanded="false"
  aria-controls="mobile-drawer"
  data-an-event="drawer_open"
>
  <span class="hamburger-icon" aria-hidden="true">
    <span class="bar bar-top"></span>
    <span class="bar bar-mid"></span>
    <span class="bar bar-bot"></span>
  </span>
</button>

<div
  class="mobile-drawer glass"
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="תפריט ניווט"
  data-open="false"
  inert
>
  <nav aria-label="ניווט ראשי - נייד">
    <ul role="list" class="drawer-nav">
      <li class="drawer-home-item">
        <a
          href="/"
          class="drawer-home-link"
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          שיר אמיתי
        </a>
      </li>

      {headerItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="drawer-link"
            aria-current={currentPath === item.href || currentPath.startsWith(item.href + '/') ? 'page' : undefined}
            data-reveal
            data-an-event="nav_click"
            data-an-cta-label={item.label}
            data-an-placement="drawer"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    block-size: 72px;
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  /* The glass lives on its own layer so scroll animates opacity, not
     backdrop-filter - transitioning the filter itself vibrates visibly. */
  .header-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(253, 250, 244, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--color-glass-stroke);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-soft);
    will-change: opacity;
    contain: layout paint;
  }

  .site-header.scrolled .header-bg {
    opacity: 1;
  }

  /* The morph script sets opacity inline per frame; a CSS transition would
     fight the scrub. */
  .site-header[data-home-morph] .header-bg {
    transition: none;
  }

  /* No-JS and reduced-motion safety net; otherwise the morph script owns this. */
  .site-header[data-home-morph] .wordmark {
    opacity: 0;
    pointer-events: none;
  }
  .site-header[data-home-morph].scrolled .wordmark {
    opacity: 1;
    pointer-events: auto;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .wordmark:hover { opacity: 0.7; }

  .desktop-nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--color-ink-soft);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-soft), background var(--dur-fast) var(--ease-soft);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.35);
  }
  .nav-link[aria-current="page"] { font-weight: 600; }

  .hamburger {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .hamburger:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 22px;
    height: 22px;
    gap: 0;
    position: relative;
  }

  .bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    position: absolute;
    transition:
      transform var(--dur-base) var(--ease-soft),
      opacity   var(--dur-fast) var(--ease-soft);
  }

  .bar-top { transform: translateY(-6px); }
  .bar-mid { transform: translateY(0); }
  .bar-bot { transform: translateY(6px); }

  /* Bars rotate into × */
  .hamburger[aria-expanded="true"] .bar-top {
    transform: translateY(0) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] .bar-bot {
    transform: translateY(0) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { transition: none; }
  }

  /* Always in the DOM, held off-screen by transform. Anchored to the same
     edge as the hamburger so it feels connected to the tap target. */
  .mobile-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;          /* left edge in RTL */
    inline-size: min(320px, 85vw);
    z-index: 200;
    /* Top padding clears the fixed 56px hamburger. */
    padding: calc(56px + 1rem) 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* Overrides .glass: rounded on the interior side, flush to the screen
       edge on the inline-end side it is anchored to. */
    border-start-start-radius: var(--radius-card);
    border-end-start-radius:   var(--radius-card);
    border-start-end-radius:   0;
    border-end-end-radius:     0;
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-end;
  }
  .mobile-drawer[data-open="true"] {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-start;
  }

  .drawer-nav { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }

  .drawer-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--color-ink);
    transition: background var(--dur-fast);
  }
  .drawer-link:hover,
  .drawer-link[aria-current="page"] { background: rgba(255, 255, 255, 0.4); }

  .drawer-home-item {
    margin-block-end: 0.5rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-glass-stroke);
  }

  .drawer-home-link {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: background var(--dur-fast);
  }
  .drawer-home-link:hover,
  .drawer-home-link[aria-current="page"] { background: rgba(255, 255, 255, 0.4); }

  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 190;
    background: rgba(34, 51, 42, 0.25);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-end;
  }
  .drawer-backdrop.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-base) var(--ease-soft),
      visibility var(--dur-base) step-start;
  }

  @media (max-width: 767px) {
    .site-header { block-size: 56px; }
    .desktop-nav { display: none; }

    /* Fixed independently of the header so it floats above the drawer. */
    .hamburger {
      display: flex;
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: 0;
      block-size: 56px;
      z-index: 300; /* above drawer (200) and backdrop (190) */
      padding-inline: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .mobile-drawer,
    .drawer-backdrop { display: none !important; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const header = document.getElementById('site-header') as HTMLElement | null;
  const headerBg = header?.querySelector<HTMLElement>('.header-bg');
  const wordmark = document.getElementById('header-wordmark') as HTMLElement | null;
  const isHome = header?.dataset.homeMorph === 'true';
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * While the wordmark is faded out it must leave the tab order: an
   * invisible-but-focusable link fails SC 2.4.7, the focus ring landing on
   * nothing the visitor can see.
   */
  const setWordmarkHidden = (hidden: boolean) => {
    if (!wordmark || !isHome) return;
    if (hidden) {
      wordmark.setAttribute('tabindex', '-1');
      wordmark.setAttribute('aria-hidden', 'true');
    } else {
      wordmark.removeAttribute('tabindex');
      wordmark.removeAttribute('aria-hidden');
    }
  };

  if (header && !isHome) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:80px;left:0;width:1px;height:1px;pointer-events:none;';
    document.body.prepend(sentinel);

    const io = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { rootMargin: '0px' },
    );
    io.observe(sentinel);
  }

  // Home: the wordmark scales down into place as the hero exits, so the hero
  // title reads as "becoming" the header.
  if (header && wordmark && headerBg && isHome) {
    const hero = document.querySelector<HTMLElement>('.hero');

    if (hero) {
      if (prefersReducedMotion) {
        const io = new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('scrolled', !entry.isIntersecting);
            setWordmarkHidden(entry.isIntersecting);
          },
          { threshold: 0 },
        );
        io.observe(hero);
      } else {
        ScrollTrigger.getById('header-morph')?.kill();

        ScrollTrigger.create({
          id: 'header-morph',
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          onUpdate: (self) => {
            const p = self.progress;

            const bgFade = gsap.utils.clamp(0, 1, (p - 0.6) / 0.4);
            headerBg!.style.opacity = String(bgFade);

            const wordmarkProgress = gsap.utils.clamp(0, 1, (p - 0.5) / 0.5);
            const scale = gsap.utils.interpolate(1.8, 1, wordmarkProgress);
            const opacity = wordmarkProgress;

            wordmark!.style.opacity = String(opacity);
            wordmark!.style.transform = wordmarkProgress < 1 ? `scale(${scale})` : '';
            wordmark!.style.transformOrigin = 'center center';

            // Reachable only once it is actually legible.
            setWordmarkHidden(opacity < 0.5);
          },
          onLeave: () => {
            wordmark!.style.opacity = '';
            wordmark!.style.transform = '';
            headerBg!.style.opacity = '';
            header.classList.add('scrolled');
            setWordmarkHidden(false);
          },
          onEnterBack: () => {
            header.classList.remove('scrolled');
          },
          onLeaveBack: () => {
            wordmark!.style.opacity = '0';
            wordmark!.style.transform = 'scale(1.8)';
            headerBg!.style.opacity = '0';
            header.classList.remove('scrolled');
            setWordmarkHidden(true);
          },
        });
      }
    }
  }

  const btn      = document.getElementById('mobile-menu-btn');
  const drawer   = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  const isOpen = () => drawer?.getAttribute('data-open') === 'true';

  const drawerFocusables = () =>
    Array.from(
      drawer?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? [],
    ).filter((el) => el.offsetParent !== null);

  const openDrawer = () => {
    drawer?.removeAttribute('inert');
    drawer?.setAttribute('data-open', 'true');
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'סגירת תפריט ניווט');
    backdrop?.classList.add('visible');
    document.body.style.overflow = 'hidden';
    // Focus must enter the dialog, not continue through the page behind it.
    drawerFocusables()[0]?.focus();
  };

  const closeDrawer = () => {
    drawer?.setAttribute('inert', '');
    drawer?.setAttribute('data-open', 'false');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'פתיחת תפריט ניווט');
    backdrop?.classList.remove('visible');
    document.body.style.overflow = '';
  };

  /** Closes and returns focus to the hamburger, unlike closeDrawer. */
  const dismissDrawer = () => {
    closeDrawer();
    btn?.focus();
  };

  btn?.addEventListener('click', () => {
    isOpen() ? dismissDrawer() : openDrawer();
  });
  backdrop?.addEventListener('click', dismissDrawer);

  // Following a link navigates away - close without stealing focus.
  drawer?.querySelectorAll('.drawer-link, .drawer-home-link').forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', (e) => {
    // Guard first, or Escape anywhere on the site yanks focus to the hamburger.
    if (!isOpen()) return;

    if (e.key === 'Escape') {
      dismissDrawer();
      return;
    }

    // aria-modal="true" promises focus stays inside; the hamburger counts as
    // part of the dialog since it floats above it and closes it.
    if (e.key === 'Tab') {
      const items = drawerFocusables();
      if (btn) items.push(btn);
      if (items.length === 0) return;

      const first = items[0];
      const last  = items[items.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
