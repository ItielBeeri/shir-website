---
/**
 * TherapyPage — shared template for all three therapy pages.
 * 
 * New layout: Content-first, no hero barrier.
 * - Title/image block at top (natural height)
 * - Intro text flows directly below
 * - Body content continues naturally with the text
 * - Images are integrated throughout via the MDX content
 */
import BaseLayout from '../layout/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import ContactPill from '../layout/ContactPill.astro';
import SoftImage from '../ui/SoftImage.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BreathDivider from '../ui/BreathDivider.astro';
import CTAButton from '../ui/CTAButton.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';
import RecommendationsSection from '../home/RecommendationsSection.astro';
import { loadToml } from '../../lib/content';
import { getCollection } from 'astro:content';
import { z } from 'zod';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'therapies'>;
}

const { entry } = Astro.props;
const { title, kicker, accent, hero_image, summary } = entry.data;
const { Content } = await render(entry);

const siteSchema = z.object({
  contact: z.object({
    whatsapp_url:   z.string(),
    whatsapp_label: z.string(),
    phone_href:     z.string(),
    phone_display:  z.string(),
    phone_label:    z.string(),
    email_href:     z.string(),
    email_label:    z.string(),
  }),
});
const imagesSchema = z.record(z.string(), z.object({ file: z.string(), preview: z.string().optional(), alt: z.string() }));
const recommendationsSchema = z.object({
  recommendations: z.array(z.object({
    id: z.string().min(1),
    transcription: z.string().min(1),
    relatedTherapies: z.array(z.string()).default([]),
    author_label: z.string().optional(),
    date_label: z.string().optional(),
    approved: z.boolean().default(false),
    active: z.boolean().default(true),
  })),
});

const { contact } = loadToml('site.toml', siteSchema);
const images = loadToml('images.toml', imagesSchema);
const recommendationData = loadToml('recommendations.toml', recommendationsSchema);
const therapyRecommendations = recommendationData.recommendations.filter((item) => {
  if (!images[item.id]) return false;
  return item.approved && item.active && item.relatedTherapies.includes(entry.slug);
});

const allTherapies = (await getCollection('therapies')).sort((a, b) => a.data.order - b.data.order);
const relatedTherapies = allTherapies.filter((t) => t.slug !== entry.slug).slice(0, 2);
---

<BaseLayout
  title={title}
  description={summary}
  theme={accent}
>
  <Header />

  <main id="main">
    <!-- Intro: Image + title block (natural height, not full viewport) -->
    <section class="therapy-intro" data-theme={accent} aria-labelledby="therapy-h1">
      <div class="therapy-intro__inner container">
        <div class="therapy-intro__text">
          <p class="therapy-kicker">{kicker}</p>
          <h1 id="therapy-h1" class="therapy-title">{title}</h1>
          <div class="therapy-rule" aria-hidden="true">
            <svg viewBox="0 0 320 12" preserveAspectRatio="none" class="therapy-rule-svg">
              <path
                class="rule-path"
                d="M0,6 Q80,0 160,6 Q240,12 320,6"
                fill="none"
                stroke="var(--color-mist)"
                stroke-width="1"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <p class="therapy-summary">{summary}</p>
        </div>
        <div class="therapy-intro__image" data-parallax data-speed="0.92">
          <SoftImage id={hero_image} aspect="4/3" tint transitionName={`therapy-img-${entry.slug}`} />
        </div>
      </div>
    </section>

    <!-- Body content from MDX — text flows freely -->
    <section class="therapy-body container" data-reveal>
      <div class="prose">
        <Content components={{ SoftImage }} />
      </div>
    </section>

    {therapyRecommendations.length > 0 && (
      <>
        <BreathDivider />
        <RecommendationsSection
          recommendations={therapyRecommendations}
          images={images}
          title="המלצות"
          kicker="מילים מאנשים שפגשו את הדרך"
        />
      </>
    )}

    <BreathDivider />

    <!-- CTA strip -->
    <section class="therapy-cta container" aria-label="תיאום פגישה">
      <ScrollReveal>
        <SectionHeading kicker="מוזמנים לפנות" title="תיאום פגישה" center />
        <div class="cta-group">
          <CTAButton
            href={contact.whatsapp_url}
            label={contact.whatsapp_label}
            icon="whatsapp"
            variant="primary"
            external
          />
          <CTAButton
            href={contact.phone_href}
            label={`${contact.phone_label} · ${contact.phone_display}`}
            icon="phone"
            variant="secondary"
          />
          <CTAButton
            href={contact.email_href}
            label={contact.email_label}
            icon="mail"
            variant="tertiary"
          />
        </div>
      </ScrollReveal>
    </section>

    <!-- Related therapies -->
    <section class="therapy-related container" aria-labelledby="related-heading">
      <ScrollReveal>
        <SectionHeading title="מסלולים אחרים" center id="related-heading" />
        <div class="related-grid">
          {relatedTherapies.map((therapy) => (
            <a href={`/${therapy.slug}`} class="related-card">
              <div class="related-image">
                <SoftImage id={therapy.data.hero_image} aspect="4/3" tint />
              </div>
              <div class="related-content">
                <p class="related-kicker">{therapy.data.kicker}</p>
                <h3 class="related-title">{therapy.data.title}</h3>
                <span class="link-underline related-link">
                  להמשך קריאה ←
                </span>
              </div>
            </a>
          ))}
        </div>
      </ScrollReveal>
    </section>
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  .therapy-intro {
    padding-block-start: clamp(3rem, 6vh, 5rem);
    padding-block-end: var(--space-section);
    position: relative;
  }

  .therapy-intro__inner {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .therapy-intro__image {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .therapy-intro__image :global(img) {
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .therapy-intro__text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .therapy-kicker {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-ink-soft);
    letter-spacing: 0.08em;
    margin-block-end: 0.25rem;
  }

  .therapy-title {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: var(--lh-display);
    color: var(--color-ink);
    margin-block-end: 0.25rem;
  }

  .therapy-rule {
    inline-size: min(100%, 260px);
    margin-block-end: 0.75rem;
  }

  .therapy-rule-svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .rule-path {
    animation: rule-drift 8s ease-in-out infinite alternate;
  }

  @keyframes rule-drift {
    from { d: path("M0,6 Q80,0 160,6 Q240,12 320,6"); }
    to   { d: path("M0,6 Q80,12 160,6 Q240,0 320,6"); }
  }

  .therapy-summary {
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--color-ink-soft);
    line-height: var(--lh-body);
    white-space: pre-line;
  }

  .therapy-body {
    padding-block: var(--space-section);
  }

  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    display: flow-root;
  }

  .prose :global(h2) {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 2.5rem 1rem;
  }

  .prose :global(h3) {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 1.5rem 0.75rem;
  }

  .prose :global(p) {
    margin-block-end: 1.25rem;
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-inline-start: 1.5rem;
    margin-block-end: 1.25rem;
  }

  .prose :global(li) {
    margin-block-end: 0.5rem;
  }

  .prose :global(img) {
    margin-block: 2rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .prose :global(figure:not(.soft-image)) {
    margin-block: 2rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* Clear floats after h2 headings to start fresh sections */
  .prose :global(h2) {
    clear: both;
  }

  .therapy-cta {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-block);
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .therapy-related {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-block);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 900px;
  }

  .related-card {
    display: block;
    background: var(--color-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft);
  }

  .related-card:hover,
  .related-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .related-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .related-image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .related-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .related-card:hover .related-image :global(img) {
    transform: scale(1.05);
  }

  .related-content {
    padding: 1.25rem;
  }

  .related-kicker {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    margin-block-end: 0.35rem;
  }

  .related-title {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  .related-link {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .therapy-intro__inner {
      grid-template-columns: 1fr;
    }

    .therapy-intro__image {
      max-inline-size: 320px;
      margin-inline: auto;
    }

    .therapy-intro__text {
      text-align: center;
      align-items: center;
    }

    .therapy-rule {
      margin-inline: auto;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule-path {
      animation: none;
    }
  }
</style>
