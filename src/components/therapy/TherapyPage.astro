---
/**
 * TherapyPage — shared template for all three therapy pages.
 * Used by psychotherapy.astro, shiatsu.astro, voice.astro.
 */
import BaseLayout from '../layout/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import ContactPill from '../layout/ContactPill.astro';
import GlassCard from '../ui/GlassCard.astro';
import SoftImage from '../ui/SoftImage.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BreathDivider from '../ui/BreathDivider.astro';
import CTAButton from '../ui/CTAButton.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { loadToml } from '../../lib/content';
import { getCollection } from 'astro:content';
import { z } from 'zod';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'therapies'>;
}

const { entry } = Astro.props;
const { title, kicker, accent, hero_image, summary } = entry.data;
const { Content } = await render(entry);

const siteSchema = z.object({
  contact: z.object({
    whatsapp_url:   z.string(),
    whatsapp_label: z.string(),
    phone_href:     z.string(),
    phone_display:  z.string(),
    phone_label:    z.string(),
    email_href:     z.string(),
    email_label:    z.string(),
  }),
});
const { contact } = loadToml('site.toml', siteSchema);

const allTherapies = (await getCollection('therapies')).sort((a, b) => a.data.order - b.data.order);
const relatedTherapies = allTherapies.filter((t) => t.slug !== entry.slug).slice(0, 2);
---

<BaseLayout
  title={title}
  description={summary}
  theme={accent}
>
  <Header />

  <main id="main">
    <!-- Hero with accent overlay -->
    <section class="therapy-hero" data-theme={accent} aria-labelledby="therapy-h1">
      <div class="accent-overlay" aria-hidden="true"></div>
      <div class="therapy-hero__inner container">
        <div class="therapy-hero__image" data-parallax data-speed="0.92" data-reveal>
          <SoftImage id={hero_image} aspect="4/3" tint transitionName={`therapy-img-${entry.slug}`} />
        </div>
        <div class="therapy-hero__text" data-reveal>
          <GlassCard>
            <p class="therapy-kicker">{kicker}</p>
            <div class="therapy-title-wrap">
              <h1 id="therapy-h1" class="therapy-title">{title}</h1>
              <div class="therapy-hero__rule" aria-hidden="true">
                <svg viewBox="0 0 320 12" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="hero-rule-svg">
                  <path
                    class="rule-path"
                    d="M0,6 Q80,0 160,6 Q240,12 320,6"
                    fill="none"
                    stroke="var(--color-mist)"
                    stroke-width="1"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
            </div>
            <p class="therapy-summary">{summary}</p>
          </GlassCard>
        </div>
      </div>
    </section>

    <!-- Body content from MDX -->
    <section class="therapy-body container" data-reveal>
      <GlassCard>
        <div class="prose">
          <Content />
        </div>
      </GlassCard>
    </section>

    <!-- CTA strip -->
    <section class="therapy-cta container" aria-label="תיאום פגישה">
      <ScrollReveal>
        <SectionHeading kicker="מוזמנים לפנות" title="תיאום פגישה" center />
        <div class="cta-group">
          <!-- WhatsApp → Phone → Email (§5.4) -->
          <CTAButton
            href={contact.whatsapp_url}
            label={contact.whatsapp_label}
            icon="whatsapp"
            variant="primary"
            external
          />
          <CTAButton
            href={contact.phone_href}
            label={`${contact.phone_label} · ${contact.phone_display}`}
            icon="phone"
            variant="secondary"
          />
          <CTAButton
            href={contact.email_href}
            label={contact.email_label}
            icon="mail"
            variant="tertiary"
          />
        </div>
      </ScrollReveal>
    </section>

    <!-- Related therapies -->
    <section class="therapy-related container" aria-labelledby="related-heading">
      <ScrollReveal>
        <SectionHeading title="מסלולים אחרים" center id="related-heading" />
        <div class="related-grid">
          {relatedTherapies.map((therapy) => (
            <a href={`/${therapy.slug}`} class="related-card">
              <div class="related-image">
                <SoftImage id={therapy.data.hero_image} aspect="4/3" tint />
              </div>
              <div class="related-content">
                <p class="related-kicker">{therapy.data.kicker}</p>
                <h3 class="related-title">{therapy.data.title}</h3>
                <span class="link-underline related-link">
                  להמשך קריאה ←
                </span>
              </div>
            </a>
          ))}
        </div>
      </ScrollReveal>
    </section>
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  /* Hero with accent */
  .therapy-hero {
    position: relative;
    min-block-size: 100svh;
    display: flex;
    align-items: center;
    padding-block: var(--space-section);
    overflow: hidden;
  }

  .accent-overlay {
    position: absolute;
    inset: 0;
    background: var(--accent, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .therapy-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .therapy-hero__image {
    position: relative;
  }

  .therapy-hero__image :global(img) {
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .therapy-hero__rule {
    inline-size: min(100%, 320px);
    margin-inline: auto;
    margin-block-start: clamp(0.4rem, 1vh, 0.9rem);
    margin-block-end: clamp(1.2rem, 3vh, 2rem);
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: center;
    animation: fadeInScale 0.8s var(--ease-soft) forwards 0.6s;
  }

  .hero-rule-svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .rule-path {
    animation: rule-drift 8s ease-in-out infinite alternate;
  }

  @keyframes fadeInScale {
    to { opacity: 1; transform: scaleX(1); }
  }

  @keyframes rule-drift {
    from { d: path("M0,6 Q80,0 160,6 Q240,12 320,6"); }
    to   { d: path("M0,6 Q80,12 160,6 Q240,0 320,6"); }
  }

  .therapy-title-wrap {
    position: relative;
    display: inline-block;
  }

  .therapy-kicker {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-ink-soft);
    margin-block-end: 0.5rem;
  }

  .therapy-title {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-display);
    font-weight: 200;
    letter-spacing: 0.02em;
    line-height: var(--lh-display);
    color: var(--color-ink);
    margin-block-end: 0;
  }

  .therapy-summary {
    font-size: var(--fs-body);
    color: var(--color-ink-soft);
    line-height: var(--lh-body);
    margin-block-start: 1rem;
  }

  /* Body */
  .therapy-body {
    padding-block: var(--space-section);
    position: relative;
    z-index: 1;
  }

  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    max-inline-size: 65ch;
  }

  .prose :global(h2) {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 2rem 1rem;
  }

  .prose :global(h3) {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 1.5rem 0.75rem;
  }

  .prose :global(p) { margin-block-end: 1rem; }

  .prose :global(ol), .prose :global(ul) {
    padding-inline-start: 1.5rem;
    margin-block-end: 1rem;
  }
  .prose :global(li) { margin-block-end: 0.4rem; }

  /* CTA strip */
  .therapy-cta {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-block);
    position: relative;
    z-index: 1;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Related therapies */
  .therapy-related {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-block);
    position: relative;
    z-index: 1;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 900px;
  }

  .related-card {
    display: block;
    background: var(--color-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft);
  }

  .related-card:hover,
  .related-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .related-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .related-image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .related-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .related-card:hover .related-image :global(img) {
    transform: scale(1.05);
  }

  .related-content {
    padding: 1.25rem;
  }

  .related-kicker {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    margin-block-end: 0.35rem;
  }

  .related-title {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  .related-link {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .therapy-hero__inner { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .therapy-hero__rule,
    .rule-path {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
