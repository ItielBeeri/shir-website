---
/**
 * ParallaxLayer — sets --p CSS variable based on scroll position.
 * Children use: transform: translateY(calc(var(--p) * <factor>px))
 */
interface Props {
  /** Scroll speed factor (0 = fixed, 1 = normal, 0.5 = half speed) */
  speed?: number;
  class?: string;
}

const { speed = 0.5, class: className } = Astro.props;
---

<div
  class:list={['parallax-layer', className]}
  data-parallax
  data-speed={speed}
>
  <slot />
</div>

<style>
  .parallax-layer {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-layer {
      will-change: auto;
      transform: none !important;
    }
  }
</style>
