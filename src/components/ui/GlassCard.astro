---
/**
 * GlassCard — frosted glass panel.
 * Props: hover (enable lift on hover), padding, class
 */
interface Props {
  hover?: boolean;
  padding?: string;
  class?: string;
  as?: 'div' | 'article' | 'section' | 'aside';
}

const {
  hover = false,
  padding,
  class: className,
  as: Tag = 'div',
} = Astro.props;
---

<Tag
  class:list={['glass-card', hover && 'glass-card--hover', className]}
  style={padding ? `padding: ${padding}` : undefined}
>
  <slot />
</Tag>

