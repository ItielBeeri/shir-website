---
/**
 * GlassCard — frosted glass panel.
 * Props: hover (enable lift on hover), padding, class
 */
interface Props {
  hover?: boolean;
  padding?: string;
  class?: string;
  as?: 'div' | 'article' | 'section' | 'aside';
}

const {
  hover = false,
  padding,
  class: className,
  as: Tag = 'div',
} = Astro.props;
---

<Tag
  class:list={['glass-card', hover && 'glass-card--hover', className]}
  style={padding ? `padding: ${padding}` : undefined}
>
  <slot />
</Tag>

<style>
  .glass-card {
    background: var(--color-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    position: relative;
    overflow: hidden;
  }

  .glass-card--hover {
    transition:
      transform var(--dur-base) var(--ease-soft),
      box-shadow var(--dur-base) var(--ease-soft);
  }

  .glass-card--hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(92, 110, 101, 0.1);
  }
</style>
