---
/**
 * SectionHeading — kicker + title + animated underline.
 * Kicker: Frank Ruhl Libre 400 small.
 * Title: Assistant 300 display.
 * Underline: draws from inline-start (right edge in RTL) on reveal.
 */
interface Props {
  kicker?: string;
  title: string;
  /** heading level — default h2 */
  level?: 2 | 3 | 4;
  /** center alignment */
  center?: boolean;
  class?: string;
  /** optional id for aria-labelledby */
  id?: string;
}

const { kicker, title, level = 2, center = false, class: className, id } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3' | 'h4';
---

<div class:list={['section-heading', center && 'section-heading--center', className]} data-reveal id={id}>
  {kicker && <p class="section-heading__kicker">{kicker}</p>}
  <Tag class="section-heading__title">{title}</Tag>
  <span class="section-heading__line" aria-hidden="true"></span>
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
  }

  .section-heading__kicker {
    font-family: 'Frank Ruhl Libre', 'David Libre', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-ink-soft);
    letter-spacing: 0.02em;
  }

  .section-heading__title {
    font-size: var(--fs-h2);
    font-weight: 300;
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-display);
  }

  .section-heading__line {
    display: block;
    block-size: 1.5px;
    inline-size: 0;
    background: var(--accent, var(--color-teal));
    border-radius: 2px;
    margin-block-start: 0.25rem;
    transition: inline-size var(--dur-slow) var(--ease-soft);
  }

  .is-visible .section-heading__line {
    inline-size: 50px;
  }

  .section-heading--center .section-heading__line {
    align-self: center;
  }
</style>
