---
/** Inline SVG from src/icons/. Pass `label` or `decorative`, never neither. */
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  /** Hebrew, and required unless decorative. */
  label?: string;
  decorative?: boolean;
  /** px, applied as both width and height. Defaults to 1em. */
  size?: number;
  class?: string;
}

const {
  name,
  label,
  decorative = false,
  size,
  class: className,
} = Astro.props;
---

{decorative ? (
  <AstroIcon
    name={name}
    aria-hidden="true"
    focusable="false"
    style={size ? `width:${size}px;height:${size}px` : undefined}
    class={className}
  />
) : (
  <AstroIcon
    name={name}
    title={label}
    role="img"
    aria-label={label}
    style={size ? `width:${size}px;height:${size}px` : undefined}
    class={className}
  />
)}
