---
/**
 * SoftImage — the only sanctioned image renderer.
 * Applies a watercolor feathered mask, supports tint overlay.
 * Takes an image id from images.toml.
 */
import { loadToml } from '../../lib/content';
import { z } from 'zod';

interface Props {
  /** Image id from images.toml */
  id: string;
  /** Optional accent tint at low opacity */
  tint?: boolean;
  /** Aspect ratio e.g. "3/4", "16/9" */
  aspect?: string;
  class?: string;
  /** loading strategy */
  loading?: 'lazy' | 'eager';
}

const imagesSchema = z.record(z.string(), z.object({
  file:    z.string(),
  alt:     z.string(),
  credit:  z.string().optional(),
}));

const images = loadToml('images.toml', imagesSchema);

const { id, tint = false, aspect = '4/3', class: className, loading = 'lazy' } = Astro.props;

const image = images[id];
// Graceful fallback if image id not found
const src = image?.file ?? '/img/content/placeholder.jpg';
const alt = image?.alt ?? '';
---

<figure
  class:list={['soft-image', tint && 'soft-image--tint', className]}
  style={`aspect-ratio: ${aspect}`}
>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    class="soft-image__img"
  />
  {tint && <div class="soft-image__tint" aria-hidden="true"></div>}
</figure>

<style>
  .soft-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    /* Watercolor feathered mask — irregular organic shape */
    -webkit-mask-image: radial-gradient(
      ellipse 90% 90% at 50% 50%,
      black 55%,
      rgba(0,0,0,0.6) 70%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 90% 90% at 50% 50%,
      black 55%,
      rgba(0,0,0,0.6) 70%,
      transparent 100%
    );
    margin: 0;
  }

  .soft-image__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .soft-image__tint {
    position: absolute;
    inset: 0;
    background: var(--accent, var(--color-teal));
    mix-blend-mode: soft-light;
    opacity: 0.18;
    pointer-events: none;
  }
</style>
