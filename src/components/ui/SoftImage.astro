---
/**
 * The only sanctioned image renderer: takes an id from images.toml and sources
 * its alt from there. Falls back to a bare <img> of the original when no
 * derivatives exist yet, so a freshly dropped-in image always paints.
 */
import { loadToml } from '../../lib/content';
import { imageSources } from '../../lib/images';
import { z } from 'zod';

interface Props {
  /** Image id from images.toml */
  id: string;
  tint?: boolean;
  /** e.g. "3/4", "16/9" */
  aspect?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /**
   * Layout width of the slot. Defaults are guesses; pass the real slot width
   * wherever it is known, which is every call site outside MDX body copy.
   */
  sizes?: string;
  /** Set on a page's LCP image, nowhere else. */
  fetchpriority?: 'high' | 'auto';
  transitionName?: string;
  float?: 'start' | 'end';
  /**
   * Width in px, e.g. "300". A float defaults to 280; an image that does not
   * float fills the column unless given one, and is then centred at it.
   */
  width?: string;
  /** The same as `width`: the name the owner's editing guide teaches. */
  floatWidth?: string;
}

const imagesSchema = z.record(z.string(), z.object({
  file:    z.string(),
  alt:     z.string(),
  credit:  z.string().optional(),
}));

const images = loadToml('images.toml', imagesSchema);

const {
  id,
  tint = false,
  aspect = '4/3',
  class: className,
  loading = 'lazy',
  sizes,
  fetchpriority,
  transitionName,
  float,
  width: authoredWidth,
  floatWidth,
} = Astro.props;

const slotWidth = authoredWidth ?? floatWidth ?? (float ? '280' : undefined);
const centred = !float && slotWidth !== undefined;

const image = images[id];
const src = image?.file ?? '/img/content/placeholder.jpg';
const alt = image?.alt ?? '';
const { avif, webp, width, height } = imageSources(src);

const defaultSizes = float
  ? `(max-width: 768px) 100vw, ${slotWidth}px`
  : centred
    ? `(max-width: ${slotWidth}px) 100vw, ${slotWidth}px`
    : '(max-width: 768px) 100vw, 800px';
const authoredSizes = sizes ?? defaultSizes;

/*
 * `sizes` describes the slot, but object-fit: cover paints wider than the slot
 * whenever the photo is wider than its box - a 945x708 in a 3/4 frame renders
 * 1.78x the slot width. Uncorrected, the browser picks a source two rungs too
 * small and upscales it, which on watercolour imagery shifts colour rather
 * than merely blurring.
 *
 * The factor scales only the trailing length of each comma-separated entry,
 * never a length inside a media condition - that describes the viewport.
 */
const [aspectW, aspectH] = aspect.split('/').map((n) => Number(n.trim()));
const boxRatio = aspectW / aspectH;
const imageRatio = width && height ? width / height : boxRatio;
const ratio = imageRatio / boxRatio;
// Guards an `aspect` that is not a w/h fraction against NaN reaching `sizes`.
const coverFactor = Number.isFinite(ratio) ? Math.max(1, ratio) : 1;

const resolvedSizes = authoredSizes
  .split(',')
  .map((entry) => {
    const trimmed = entry.trim();
    return trimmed.replace(
      /(-?[\d.]+)(px|vw|vh|rem|em)$/,
      (_, value, unit) => `${Math.round(Number(value) * coverFactor)}${unit}`,
    );
  })
  .join(', ');
---

<figure
  class:list={[
    'soft-image',
    tint && 'soft-image--tint',
    float && 'soft-image--float',
    float && `soft-image--float-${float}`,
    centred && 'soft-image--centred',
    className
  ]}
  style={`
    aspect-ratio: ${aspect};
    ${slotWidth ? `--image-width: ${slotWidth}px;` : ''}
    ${transitionName ? `view-transition-name: ${transitionName};` : ''}
  `.replace(/\s+/g, ' ').trim()}
>
  <picture>
    {avif && <source type="image/avif" srcset={avif} sizes={resolvedSizes} />}
    {webp && <source type="image/webp" srcset={webp} sizes={resolvedSizes} />}
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="soft-image__img"
    />
  </picture>
  {tint && <div class="soft-image__tint" aria-hidden="true"></div>}
</figure>

<style>
  .soft-image {
    display: block;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    margin-block-end: 1rem;
    margin-inline-start: auto;
    margin-inline-end: auto;
  }

  /* <picture> selects sources only; it must not become a layout box between
     .soft-image and the image sizing itself against it. */
  .soft-image picture {
    display: contents;
  }

  .soft-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .soft-image:hover .soft-image__img {
    transform: scale(1.03);
  }

  .soft-image__tint {
    position: absolute;
    inset: 0;
    background: var(--accent-soft);
    mix-blend-mode: multiply;
    opacity: 0.15;
    pointer-events: none;
    border-radius: inherit;
  }

  .soft-image--float {
    margin: 0;
    margin-block-end: 1.5rem;
    shape-outside: margin-box;
  }

  /*
   * Physical value first, logical second: `float: inline-*` is Chrome 118+,
   * and an engine older than that drops the declaration and leaves the image
   * stacked above the text rather than beside it. dir="rtl" is sitewide, so
   * the two can never disagree.
   */
  .soft-image--float-start {
    float: right;
    float: inline-start;
    margin-inline-end: 1.5rem;
    width: var(--image-width);
  }

  .soft-image--float-end {
    float: left;
    float: inline-end;
    margin-inline-start: 1.5rem;
    width: var(--image-width);
  }

  /* On a row of its own: a float above it would otherwise sit beside it. */
  .soft-image--centred {
    width: var(--image-width);
    max-width: 100%;
    clear: both;
  }

  @media (max-width: 768px), (max-inline-size: 600px) {
    .soft-image--float {
      float: none;
      width: 100%;
      margin-inline: 0;
      margin-block-end: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soft-image__img {
      transition: none;
    }
    .soft-image:hover .soft-image__img {
      transform: none;
    }
  }
</style>
