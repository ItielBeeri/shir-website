---
/**
 * CTAButton — primary/secondary/tertiary contact CTA.
 * Variants:
 *   primary   — WhatsApp (filled, accent-tinted)
 *   secondary — phone (outlined/ghost)
 *   tertiary  — email (text + icon only)
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  /** Icon name from src/icons/ */
  icon?: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
  /** Opens in new tab */
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  icon,
  variant = 'primary',
  external = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['cta-btn', `cta-btn--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  aria-label={external ? `${label} — נפתח בטאב חדש` : undefined}
>
  {icon && <Icon name={icon} decorative size={variant === 'primary' ? 22 : 18} />}
  <span>{label}</span>
</a>

<style>
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: var(--radius-pill);
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-weight: 400;
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-soft),
      background var(--dur-fast) var(--ease-soft),
      box-shadow var(--dur-fast) var(--ease-soft);
    text-decoration: none;
  }

  /* Primary — WhatsApp */
  .cta-btn--primary {
    background: var(--color-seafoam);
    color: var(--color-ink);
    padding: 0.85rem 1.75rem;
    font-size: var(--fs-body);
    font-weight: 600;
    box-shadow: 0 4px 20px rgba(166, 212, 200, 0.35);
    min-block-size: 52px;
    min-inline-size: 48px;
  }
  .cta-btn--primary:hover {
    background: var(--color-teal);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(166, 212, 200, 0.45);
  }

  /* Secondary — phone */
  .cta-btn--secondary {
    background: transparent;
    color: var(--color-ink);
    padding: 0.75rem 1.5rem;
    font-size: var(--fs-body);
    border: 1.5px solid var(--color-ink-soft);
    min-block-size: 48px;
    min-inline-size: 48px;
  }
  .cta-btn--secondary:hover {
    background: rgba(255,255,255,0.35);
    transform: translateY(-2px);
    border-color: var(--color-ink);
  }

  /* Tertiary — email */
  .cta-btn--tertiary {
    background: transparent;
    color: var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
    font-size: var(--fs-small);
    min-block-size: 44px;
    min-inline-size: 44px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(74, 92, 81, 0.3);
  }
  .cta-btn--tertiary:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink-soft);
  }
</style>
