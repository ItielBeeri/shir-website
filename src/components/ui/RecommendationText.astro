---
/**
 * The screenshot's transcription as real text, since a screenshot is an image
 * of text (SC 1.4.5) - and the screenshot itself stays, because it is what
 * makes the recommendation verifiably real.
 *
 * <details> rather than always-visible text or a scripted disclosure: it is
 * keyboard- and screen-reader-operable with no JavaScript at all. The
 * accessible name is a noun phrase, not "הצגת...", because <details> already
 * exposes its expanded state - so the name reads correctly either way and
 * needs no rewriting on toggle.
 */
import Icon from './Icon.astro';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;

const LABEL = 'ההמלצה כטקסט';
---

<details class:list={['rec-text', className]}>
  <!-- data-an-* rather than a toggle listener, so this component stays
       script-free as designed. It therefore counts opens and closes alike,
       which the event name admits to. -->
  <summary
    class="rec-text__summary"
    aria-label={LABEL}
    title={LABEL}
    data-an-event="recommendation_toggle"
  >
    <span class="rec-text__summary-inner">
      <Icon name="quote" decorative size={16} />
    </span>
  </summary>
  <p class="rec-text__body">{text}</p>
</details>

<style>
  .rec-text {
    /* Pins the control to the same place in both card layouts - the gallery
       card is a centring flex column, the home card a plain block. */
    inline-size: 100%;
    margin-block-start: 0.25rem;
    font-size: var(--fs-small);
  }

  /* The layout lives on an inner span because overriding `display` on a
     <summary>, flex especially, is a cross-browser hazard. */
  .rec-text__summary {
    color: var(--color-ink-soft);
    cursor: pointer;
    list-style: none;
    inline-size: fit-content;
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .rec-text__summary::-webkit-details-marker { display: none; }
  .rec-text__summary::marker { content: ''; }

  /* 44x44 hit target around a deliberately small glyph. */
  .rec-text__summary-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
  }

  .rec-text__summary:hover,
  .rec-text[open] .rec-text__summary {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.4);
  }

  .rec-text__summary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .rec-text__body {
    /* The transcriptions carry the sender's own line breaks. */
    white-space: pre-line;
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    padding-block-start: 0.25rem;
  }
</style>
