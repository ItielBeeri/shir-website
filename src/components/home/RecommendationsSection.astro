---
/**
 * RecommendationsSection — recommendations teaser for the home and therapy pages.
 *
 * Shows the full screenshots (never a crop, never a modal, never inner scrolling):
 * two justified lines on desktop, a horizontal scroll-snap strip on narrow
 * screens. The heading row is the BlogTeaser's — kicker, title and a "see all"
 * text link at the far end. Two lines rather than the blog's one because a
 * recommendation carries a whole message, and only two of those fit across a
 * line at a readable size.
 *
 * Sizing is driven by the *type inside* each screenshot, not by its frame. The
 * screenshots are captures from different phones and apps, so a given frame
 * width says little about how big its letters are — sizing every card to a
 * shared height (or a shared width) leaves one card's text twice the size of its
 * neighbour's. Instead each card's width is proportional to the screenshot's
 * measured `typeUnits`, which lands every screenshot on the same rendered type
 * size, close to the page's own body size. Heights then differ — a longer
 * message really is taller — so cards sit centred on their line's axis.
 *
 * The dedicated /recommendations page owns the full masonry gallery.
 */
import GlassCard from '../ui/GlassCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { screenshotMetrics } from '../../lib/screenshots';

interface Recommendation {
  id: string;
  transcription: string;
  relatedTherapies?: string[];
  author_label?: string;
  date_label?: string;
}

interface ImageRecord {
  file: string;
  alt: string;
}

interface Props {
  recommendations: Recommendation[];
  images: Record<string, ImageRecord>;
  title?: string;
  kicker?: string;
  id?: string;
  showAllLink?: boolean;
  allLinkText?: string;
  allLinkHref?: string;
  /**
   * How many cards to render, which is also how many the strip shows.
   * Desktop shows the first two lines of them — see LINE_LENGTH.
   */
  limit?: number;
}

const {
  recommendations,
  images,
  title = 'המלצות',
  kicker = 'מילים מאנשים שפגשו את הדרך',
  id: headingId = 'recommendations-heading',
  showAllLink = true,
  allLinkText = 'לכל ההמלצות',
  allLinkHref = '/recommendations',
  limit = 6,
} = Astro.props;

/**
 * Cards per desktop line. Two is what fits across this container at a readable
 * type size; the CSS below hides every line after the second.
 */
const LINE_LENGTH = 2;

const total = recommendations.length;

const items = await Promise.all(
  recommendations.slice(0, limit).map(async (rec) => {
    const image = images[rec.id];
    const { width, height, typeUnits } = await screenshotMetrics(image.file);
    return { ...rec, image, width, height, typeUnits };
  }),
);

/**
 * Lines keep the running order — each is the next slice, never a reshuffle.
 * Beyond the second they exist only for the mobile strip.
 */
const lines = Array.from({ length: Math.ceil(items.length / LINE_LENGTH) }, (_, i) =>
  items.slice(i * LINE_LENGTH, (i + 1) * LINE_LENGTH),
);

/**
 * The widest card the strip has to fit on screen. Normalising the strip to it
 * keeps every card's type the same size while still showing each screenshot
 * whole — see --rec-strip-w below.
 */
const maxTypeUnits = Math.max(...items.map((item) => item.typeUnits));

/**
 * The desktop lines are sized off whichever of them needs the most width per
 * unit of type — the "tightest" line. That line fills the container exactly and
 * the other falls a little short of it, which is the price of the two lines
 * sharing one type size rather than each justifying to its own.
 */
const desktopLines = lines.slice(0, 2);
const tightestLine = desktopLines.reduce(
  (tightest, line) => {
    const units = line.reduce((sum, item) => sum + item.typeUnits, 0);
    return units > tightest.units ? { units, count: line.length } : tightest;
  },
  { units: 0, count: 1 },
);
---

{items.length > 0 && (
  <section class="recommendations container" aria-labelledby={headingId}>
    <div class="recommendations-header" data-reveal>
      <div class="recommendations-heading">
        <SectionHeading kicker={kicker} title={title} id={headingId} />
        <span class="recommendations-count">
          {total === 1 ? 'המלצה אחת' : `${total} המלצות`}
        </span>
      </div>
      {showAllLink && (
        <a href={allLinkHref} class="link-underline recommendations-see-all">
          {allLinkText} ←
        </a>
      )}
    </div>

    <div
      class="recommendations-lines"
      data-reveal
      data-stagger="80"
      style={`--rec-units-max: ${maxTypeUnits.toFixed(3)}; --rec-units-line: ${tightestLine.units.toFixed(3)}; --rec-line-count: ${tightestLine.count};`}
    >
      {lines.map((line) => (
        <div class="recommendations-line">
          {line.map((rec) => (
            <article class="rec-tile" data-reveal style={`--rec-units: ${rec.typeUnits.toFixed(3)};`}>
              <GlassCard>
                <img
                  class="rec-tile__img"
                  src={rec.image.file}
                  alt={rec.image.alt}
                  width={rec.width}
                  height={rec.height}
                  loading="lazy"
                  decoding="async"
                />
                <p class="sr-only">{rec.transcription}</p>
              </GlassCard>
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .recommendations { padding-block: var(--space-section); }

  /* Heading row — same shape as .blog-teaser-header */
  .recommendations-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: var(--space-block);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .recommendations-heading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .recommendations-count {
    font-size: var(--fs-small);
    color: var(--color-mist);
  }

  .recommendations-see-all {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  /* ============================================================
     Cards

     A card is `typeUnits × k` wide, where k is the rendered height of one
     line of the screenshot's text. Every card on a line shares one k, so the
     screenshots all read at the same size; k is capped near the page's own
     body size so they never tower over the page's text either.

     Below 960px the lines collapse into a single horizontal scroll-snap
     strip: two cards side by side there would have to shrink under page type
     size to fit, and one card alone would leave most of the line empty.
     ============================================================ */
  .recommendations-lines {
    --rec-pad: clamp(0.6rem, 1.4vw, 1rem);
    /* Card width that isn't the screenshot: padding both sides plus border */
    --rec-chrome: calc(2 * var(--rec-pad) + 2px);
    /* Largest rendered text-line height allowed. Page body copy measures
       around 10.5px the same way, so this keeps screenshot type close to
       page type at its biggest. */
    --rec-ink-max: 12px;
    /* How much of the viewport a strip card may fill */
    --rec-strip-w: 94vw;

    display: flex;
    align-items: center;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    /* Let the strip bleed past the container padding */
    padding-inline: clamp(1rem, 5vw, 4rem);
    margin-inline: calc(-1 * clamp(1rem, 5vw, 4rem));
    /* Hide the scrollbar visually but keep the scrolling */
    scrollbar-width: none;
  }

  .recommendations-lines::-webkit-scrollbar { display: none; }

  /* On the strip the lines step out of the way and every card sits in one row */
  .recommendations-line { display: contents; }

  .rec-tile {
    display: block;
    flex: 0 0 auto;
    scroll-snap-align: start;
    /*
     * Whichever limit binds — fitting the widest card on screen, or the type
     * size ceiling — binds for every card at once, because both scale with
     * this card's own typeUnits. So the strip keeps one shared type size
     * either way.
     */
    inline-size: min(
      calc(
        (var(--rec-strip-w) - var(--rec-chrome)) * var(--rec-units) / var(--rec-units-max)
        + var(--rec-chrome)
      ),
      calc(var(--rec-units) * var(--rec-ink-max) + var(--rec-chrome))
    );
  }

  .rec-tile :global(.glass-card) {
    padding: var(--rec-pad);
    display: block;
    transition: transform var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft);
  }

  .rec-tile :global(.glass-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .rec-tile__img {
    display: block;
    inline-size: 100%;
    /* The screenshot's own aspect ratio — the whole message, never cropped */
    block-size: auto;
    border-radius: calc(var(--radius-card) - 12px);
    box-shadow: 0 4px 18px rgba(34, 51, 42, 0.08);
  }

  /* ============================================================
     960px and up: two justified lines, no horizontal scrolling.

     k here is the container's free space divided by --rec-units-line, the
     type units of the tightest of the two lines. Both lines are sized off
     that one k, so a card in the lower line reads at exactly the size of the
     card above it. The tightest line fills the container; the other ends a
     little short of it, and its slack falls at the far end so both lines keep
     the same starting edge as the heading.
     ============================================================ */
  @media (min-width: 960px) {
    .recommendations-lines {
      --rec-line-overhead: calc(
        (var(--rec-line-count) - 1) * 1.5rem + var(--rec-line-count) * var(--rec-chrome)
      );

      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-inline: 0;
      margin-inline: 0;
    }

    .recommendations-line {
      display: flex;
      /* Cards start together, so each line has a flat top edge and the
         difference in message length shows as a shorter card, not as a card
         floating loose in the middle of the line. */
      align-items: flex-start;
      gap: 1.5rem;
    }

    /* Two lines is the allowance; the rest stay for the strip */
    .recommendations-line:nth-child(n+3) { display: none; }

    .rec-tile {
      inline-size: min(
        calc(var(--rec-units) * var(--rec-ink-max) + var(--rec-chrome)),
        calc(
          (100% - var(--rec-line-overhead)) * var(--rec-units) / var(--rec-units-line)
          + var(--rec-chrome)
        )
      );
      scroll-snap-align: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec-tile :global(.glass-card:hover) { transform: none; }
  }
</style>
