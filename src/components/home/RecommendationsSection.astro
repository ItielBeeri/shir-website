---
/**
 * The recommendations teaser. Screenshots show whole, never cropped and never
 * behind a modal; /recommendations owns the full gallery.
 *
 * Card width is proportional to each screenshot's measured `typeUnits`, not to
 * its frame: the captures come from different phones and apps, so sizing them
 * to a shared width or height leaves one card's letters twice the size of its
 * neighbour's. Heights differ instead, because a longer message is taller.
 */
import GlassCard from '../ui/GlassCard.astro';
import RecommendationText from '../ui/RecommendationText.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { screenshotMetrics } from '../../lib/screenshots';
import { imageSources } from '../../lib/images';

interface Recommendation {
  id: string;
  screenshot: string;
  alt: string;
  transcription: string;
  relatedTherapies?: string[];
  author_label?: string;
  date_label?: string;
}

interface Props {
  recommendations: Recommendation[];
  title?: string;
  kicker?: string;
  id?: string;
  showAllLink?: boolean;
  allLinkText?: string;
  allLinkHref?: string;
  /** Cards rendered. The strip shows all of them; the wall shows two rows. */
  limit?: number;
}

const {
  recommendations,
  title = 'המלצות',
  kicker = 'מילים מאנשים שפגשו את הדרך',
  id: headingId = 'recommendations-heading',
  showAllLink = true,
  allLinkText = 'לכל ההמלצות',
  allLinkHref = '/recommendations',
  limit = 6,
} = Astro.props;

const total = recommendations.length;

/** Card width in the wall: near-full-bleed on a phone, ~420px in the grid. */
const REC_SIZES = '(max-width: 767px) 92vw, 420px';

const items = await Promise.all(
  recommendations.slice(0, limit).map(async (rec) => {
    const { width, height, typeUnits } = await screenshotMetrics(rec.screenshot);
    return { ...rec, width, height, typeUnits, sources: imageSources(rec.screenshot) };
  }),
);
---

{items.length > 0 && (
  <section class="recommendations container" aria-labelledby={headingId}>
    <div class="recommendations-header" data-reveal>
      <div class="recommendations-heading">
        <SectionHeading kicker={kicker} title={title} id={headingId} />
        <span class="recommendations-count">
          {total === 1 ? 'המלצה אחת' : `${total} המלצות`}
        </span>
      </div>
      {showAllLink && (
        <a href={allLinkHref} class="link-underline recommendations-see-all">
          {allLinkText} ←
        </a>
      )}
    </div>

    <div class="recommendations-wall" data-reveal data-stagger="80">
      {items.map((rec) => (
        <article class="rec-tile" data-reveal style={`--rec-units: ${rec.typeUnits.toFixed(3)};`}>
          <GlassCard>
            <picture>
              {rec.sources.avif && (
                <source type="image/avif" srcset={rec.sources.avif} sizes={REC_SIZES} />
              )}
              {rec.sources.webp && (
                <source type="image/webp" srcset={rec.sources.webp} sizes={REC_SIZES} />
              )}
              <img
                class="rec-tile__img"
                src={rec.screenshot}
                alt={rec.alt}
                width={rec.width}
                height={rec.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <RecommendationText text={rec.transcription} />
          </GlassCard>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .recommendations { padding-block: var(--space-section); }

  /* Same shape as .blog-teaser-header - the two sections sit one above the
     other on the home page. */
  .recommendations-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: var(--space-block);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .recommendations-heading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .recommendations-count {
    font-size: var(--fs-small);
    color: var(--color-mist);
  }

  .recommendations-see-all {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  /*
   * A card is `typeUnits * k` wide, k being the rendered height of one line of
   * its screenshot's text; cards on a row share one k, so every screenshot
   * reads at the same size. No cards-per-row figure is set anywhere: each card
   * asks for the width its own text needs and the row wraps at whatever fits,
   * so two dense screenshots or three sparse ones both fill a row at the same
   * viewport width. Pinning the count would shrink dense captures below the
   * page's body size to make the number come out.
   *
   * basis and grow are both proportional to typeUnits, so leftover space is
   * shared in the same proportion and the shared type size survives
   * justification.
   */
  .recommendations-wall {
    --rec-pad: clamp(0.6rem, 1.4vw, 1rem);
    /* Card width that isn't screenshot: padding both sides plus border. */
    --rec-chrome: calc(2 * var(--rec-pad) + 2px);
    /* Target text-line height. Body copy measures ~10.5px the same way, so
       screenshot text sits just above it. */
    --rec-ink: 11px;
    /* Ceiling, so a card alone on a row cannot balloon its type. */
    --rec-ink-max: 13px;

    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .rec-tile {
    display: block;
    flex-grow: var(--rec-units);
    /* Shrink plus the 100% ceiling below is what keeps a card wider than its
       container from overflowing. */
    flex-shrink: 1;
    flex-basis: calc(var(--rec-units) * var(--rec-ink) + var(--rec-chrome));
    max-inline-size: min(
      100%,
      calc(var(--rec-units) * var(--rec-ink-max) + var(--rec-chrome))
    );
  }

  /* Needed for specificity over .rec-tile's own display rule, which the bare
     [hidden] attribute would lose to. The script below sets it. */
  .rec-tile[hidden] { display: none; }

  /* Rows cannot be measured without JS, so fall back to four cards - two rows
     wherever two fit side by side. */
  :global(.no-js) .rec-tile:nth-child(n + 5) { display: none; }

  .rec-tile :global(.glass-card) {
    padding: var(--rec-pad);
    display: block;
    transition: transform var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft);
  }

  .rec-tile :global(.glass-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .rec-tile__img {
    display: block;
    inline-size: 100%;
    /* The screenshot's own ratio - the whole message, never cropped. */
    block-size: auto;
    border-radius: calc(var(--radius-card) - 12px);
    box-shadow: 0 4px 18px rgba(34, 51, 42, 0.08);
  }

  /* Horizontal strip. The breakpoint is the blog teaser's on purpose: the two
     sit one above the other, and resizing past a width where one scrolls
     sideways and the other does not reads as a bug. */
  @media (max-width: 599px) {
    .recommendations-wall {
      flex-wrap: nowrap;
      align-items: center;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      /* Negative margin lets the strip bleed past the container padding. */
      padding-inline: clamp(1rem, 5vw, 4rem);
      margin-inline: calc(-1 * clamp(1rem, 5vw, 4rem));
      scrollbar-width: none;
    }

    .recommendations-wall::-webkit-scrollbar { display: none; }

    .rec-tile {
      flex-grow: 0;
      flex-shrink: 0;
      flex-basis: auto;
      scroll-snap-align: start;
      inline-size: min(
        86vw,
        calc(var(--rec-units) * var(--rec-ink-max) + var(--rec-chrome))
      );
      max-inline-size: 86vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec-tile :global(.glass-card:hover) { transform: none; }
  }
</style>

<script>
  /**
   * Caps the wall at two rows. The cap cannot be a card count in CSS, because
   * how many cards share a row is decided by the screenshots; it has to be
   * read off the finished layout. The strip is exempt - it is one row, and
   * swiping is how you reach the rest.
   */
  const wall = document.querySelector<HTMLElement>('.recommendations-wall');

  if (wall) {
    const tiles = Array.from(wall.querySelectorAll<HTMLElement>('.rec-tile'));
    const SAME_ROW = 8; // px tolerance for "started on the same row"

    /**
     * Read off the layout rather than a matchMedia of the same breakpoint:
     * two sources of truth can disagree for an instant mid-resize, and this
     * one is by definition in step with the rows being measured.
     */
    const isStrip = () => getComputedStyle(wall).flexWrap === 'nowrap';

    const apply = () => {
      // Measure with everything showing, or a previous pass biases this one.
      tiles.forEach((tile) => tile.removeAttribute('hidden'));
      if (isStrip()) return;

      const tops = tiles.map((tile) => tile.getBoundingClientRect().top);
      const rows: number[] = [];
      tops.forEach((top) => {
        if (!rows.some((row) => Math.abs(row - top) < SAME_ROW)) rows.push(top);
      });
      rows.sort((a, b) => a - b);

      const thirdRow = rows[2];
      if (thirdRow === undefined) return;
      tiles.forEach((tile, i) => {
        if (tops[i] >= thirdRow - SAME_ROW) tile.setAttribute('hidden', '');
      });
    };

    /**
     * ResizeObserver, not the resize event: its callback runs after layout has
     * settled, so the rows measured are the ones on screen. The width guard
     * stops hiding cards - a height-only change - from feeding back in.
     */
    let lastWidth = -1;
    const applyIfResized = () => {
      const width = Math.round(wall.clientWidth);
      if (width === lastWidth) return;
      lastWidth = width;
      apply();
    };

    new ResizeObserver(applyIfResized).observe(wall);

    // A ResizeObserver is delivered with the rendering steps, which a browser
    // may pause for a hidden tab; the debounce covers that, and its delay is
    // also what lets layout settle before measuring.
    let queued: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => {
      clearTimeout(queued);
      queued = setTimeout(applyIfResized, 120);
    });

    // Web fonts change the card chrome, and so can change where rows break.
    document.fonts?.ready.then(apply);
  }
</script>
