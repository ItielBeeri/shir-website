---
import GlassCard from '../ui/GlassCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CTAButton from '../ui/CTAButton.astro';
import Icon from '../ui/Icon.astro';

interface Recommendation {
  id: string;
  transcription: string;
  relatedTherapies?: string[];
  author_label?: string;
  date_label?: string;
}

interface ImageRecord {
  file: string;
  preview?: string;
  alt: string;
}

interface Props {
  recommendations: Recommendation[];
  images: Record<string, ImageRecord>;
  title?: string;
  kicker?: string;
  id?: string;
  showAllLink?: boolean;
  allLinkText?: string;
  allLinkHref?: string;
}

const {
  recommendations,
  images,
  title = 'המלצות',
  kicker = 'מילים מאנשים שפגשו את הדרך',
  id: headingId = 'recommendations-heading',
  showAllLink = true,
  allLinkText = 'לכל ההמלצות',
  allLinkHref = '/recommendations',
} = Astro.props;

const items = recommendations.map((rec) => ({
  ...rec,
  image: images[rec.id],
}));
---

{items.length > 0 && (
  <section class="recommendations" aria-labelledby={headingId} data-recommendations>
    <div class="container recommendations__header" data-reveal>
      <SectionHeading kicker={kicker} title={title} id={headingId} />
      <span class="recommendations__count">{recommendations.length} המלצות</span>
    </div>

    <div class="container">
      <div class="recommendations__grid-wrapper">
        <div class="recommendations__grid" data-recommendations-grid>
          {items.map((rec, index) => (
            <article
              class="recommendation-card"
              data-recommendation-card={index}
              aria-setsize={recommendations.length}
              aria-posinset={index + 1}
            >
              <GlassCard hover>
                <button
                  class="recommendation-card__button"
                  type="button"
                  data-recommendation-open={index}
                  aria-label={`פתיחת המלצה ${index + 1} מתוך ${recommendations.length}`}
                >
                  <span class="recommendation-card__image-frame">
                    <img
                      src={rec.image.preview ?? rec.image.file}
                      alt={rec.image.alt}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                  <span class="recommendation-card__footer">
                    <span class="recommendation-card__hint">ההמלצה המלאה</span>
                    <span class="recommendation-card__icon" aria-hidden="true">↗</span>
                  </span>
                </button>
              </GlassCard>
            </article>
          ))}
        </div>
      </div>

      {showAllLink && (
        <div class="recommendations__footer" data-reveal>
          <CTAButton
            href={allLinkHref}
            label={allLinkText}
            variant="secondary"
            icon="arrow-forward"
          />
        </div>
      )}
    </div>

    <!-- Accessible Fullscreen Modal -->
    <dialog
      class="recommendations-modal"
      data-recommendations-dialog
      aria-label="המלצה מלאה"
      data-lenis-prevent="true"
    >
      <div class="recommendations-modal__dialog-inner" data-lenis-prevent="true">
        <!-- Fixed Header -->
        <header class="recommendations-modal__header">
          <span class="recommendations-modal__counter" data-recommendation-position></span>

          <!-- Mobile Header Navigation Controls -->
          <div class="recommendations-modal__header-nav">
            <button
              class="recommendations-modal__header-btn hit-target"
              type="button"
              data-recommendation-prev
              aria-label="המלצה קודמת"
            >
              <Icon name="arrow-back" decorative size={20} />
            </button>
            <button
              class="recommendations-modal__header-btn hit-target"
              type="button"
              data-recommendation-next
              aria-label="המלצה הבאה"
            >
              <Icon name="arrow-forward" decorative size={20} />
            </button>
          </div>

          <button
            class="recommendations-modal__close hit-target"
            type="button"
            data-recommendations-close
            aria-label="סגירת ההמלצה"
          >
            <Icon name="close" decorative size={22} />
          </button>
        </header>

        <!-- Scrollable screenshot body -->
        <div class="recommendations-modal__body" data-recommendations-scrollable data-lenis-prevent="true">
          <div class="recommendations-modal__content">
            <img class="recommendations-modal__img" data-recommendation-image src="" alt="" />
            <p class="sr-only" data-recommendation-transcription></p>
          </div>
        </div>

        <!-- Floating Side Navigation Controls (Desktop) -->
        <button
          class="recommendations-modal__nav recommendations-modal__nav--side recommendations-modal__nav--next hit-target"
          type="button"
          data-recommendation-next
          aria-label="המלצה הבאה"
        >
          <Icon name="arrow-forward" decorative size={24} />
        </button>

        <button
          class="recommendations-modal__nav recommendations-modal__nav--side recommendations-modal__nav--prev hit-target"
          type="button"
          data-recommendation-prev
          aria-label="המלצה קודמת"
        >
          <Icon name="arrow-back" decorative size={24} />
        </button>
      </div>
    </dialog>
  </section>
)}

<script is:inline define:vars={{ recommendationItems: items }}>
(() => {
  const sections = document.querySelectorAll('[data-recommendations]');
  if (!sections.length) return;

  sections.forEach((section) => {
    const dialog = section.querySelector('[data-recommendations-dialog]');
    const modalBody = section.querySelector('[data-recommendations-scrollable]');
    const cards = [...section.querySelectorAll('[data-recommendation-open]')];
    const closeBtn = section.querySelector('[data-recommendations-close]');
    const nextBtns = [...section.querySelectorAll('[data-recommendation-next]')];
    const prevBtns = [...section.querySelectorAll('[data-recommendation-prev]')];
    const modalImg = section.querySelector('[data-recommendation-image]');
    const modalTranscription = section.querySelector('[data-recommendation-transcription]');
    const modalPosition = section.querySelector('[data-recommendation-position]');

    const items = recommendationItems;
    if (!items || !items.length) return;

    let currentModalIndex = 0;
    let lastOpener = null;
    let loadRequestId = 0;

    // Preload full recommendation images in background
    function preloadFullImages() {
      items.forEach((item) => {
        if (item.image?.file) {
          const img = new Image();
          img.src = item.image.file;
        }
      });
    }

    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(preloadFullImages);
    } else {
      window.setTimeout(preloadFullImages, 1500);
    }

    function setModalItem(index) {
      currentModalIndex = (index + items.length) % items.length;
      const item = items[currentModalIndex];
      const thisRequestId = ++loadRequestId;

      if (modalImg) {
        modalImg.classList.remove('is-loaded');
        modalImg.alt = item.image.alt;

        const targetSrc = item.image.file;
        const loader = new Image();
        loader.src = targetSrc;

        const onImageReady = () => {
          if (thisRequestId !== loadRequestId) return;
          modalImg.src = targetSrc;
          modalImg.classList.add('is-loaded');
        };

        if (loader.complete) {
          onImageReady();
        } else {
          loader.onload = onImageReady;
          loader.onerror = onImageReady;
        }
      }

      if (modalTranscription) {
        modalTranscription.textContent = item.transcription;
      }
      if (modalPosition) {
        modalPosition.textContent = `${currentModalIndex + 1} מתוך ${items.length}`;
      }
      if (modalBody) {
        modalBody.scrollTop = 0;
      }
    }

    function openModal(index, button) {
      lastOpener = button;
      setModalItem(index);

      // Stop Lenis background scrolling
      if (window.__lenis && typeof window.__lenis.stop === 'function') {
        window.__lenis.stop();
      }
      document.documentElement.classList.add('dialog-open');
      document.body.classList.add('dialog-open');

      dialog?.showModal();
      closeBtn?.focus();
    }

    function closeModal() {
      dialog?.close();
      document.documentElement.classList.remove('dialog-open');
      document.body.classList.remove('dialog-open');

      if (modalImg) {
        modalImg.classList.remove('is-loaded');
      }

      // Resume Lenis background scrolling
      if (window.__lenis && typeof window.__lenis.start === 'function') {
        window.__lenis.start();
      }

      if (lastOpener) {
        lastOpener.focus({ preventScroll: true });
      }
    }

    // Card clicks
    cards.forEach((button) => {
      button.addEventListener('click', () => {
        const idx = Number(button.dataset.recommendationOpen);
        if (!isNaN(idx)) openModal(idx, button);
      });

      button.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const idx = Number(button.dataset.recommendationOpen);
          if (!isNaN(idx)) openModal(idx, button);
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    nextBtns.forEach((btn) => btn.addEventListener('click', () => setModalItem(currentModalIndex + 1)));
    prevBtns.forEach((btn) => btn.addEventListener('click', () => setModalItem(currentModalIndex - 1)));

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) closeModal();
    });
    dialog?.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Touch swipe handling inside modal
    let modalTouchStartX = 0;
    let modalTouchStartY = 0;
    dialog?.addEventListener('touchstart', (e) => {
      modalTouchStartX = e.touches[0].clientX;
      modalTouchStartY = e.touches[0].clientY;
    }, { passive: true });

    dialog?.addEventListener('touchend', (e) => {
      if (!e.changedTouches.length) return;
      const diffX = e.changedTouches[0].clientX - modalTouchStartX;
      const diffY = e.changedTouches[0].clientY - modalTouchStartY;
      if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY) * 1.5) {
        if (diffX < 0) {
          // Swipe left -> Next in RTL
          setModalItem(currentModalIndex + 1);
        } else {
          // Swipe right -> Prev in RTL
          setModalItem(currentModalIndex - 1);
        }
      }
    }, { passive: true });

    // Forward wheel events anywhere in modal to modalBody scroll
    dialog?.addEventListener('wheel', (e) => {
      e.stopPropagation();
      if (modalBody && e.target !== modalBody && !modalBody.contains(e.target)) {
        modalBody.scrollTop += e.deltaY;
      }
    }, { passive: true });

    document.addEventListener('keydown', (e) => {
      if (!dialog?.open) return;
      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        // In RTL, left arrow is Next (forward in reading order)
        setModalItem(currentModalIndex + 1);
      } else if (e.key === 'ArrowRight') {
        // In RTL, right arrow is Previous (backward in reading order)
        setModalItem(currentModalIndex - 1);
      }
    });
  });
})();
</script>

<style>
  .recommendations {
    padding-block: var(--space-section);
    position: relative;
    overflow: hidden;
  }

  .recommendations__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: var(--space-block);
  }

  .recommendations__count {
    color: var(--color-mist);
    font-size: var(--fs-small);
    font-weight: 400;
    white-space: nowrap;
    padding-inline-end: 0.5rem;
  }

  /* Grid wrapper using CSS Container Queries */
  .recommendations__grid-wrapper {
    container-type: inline-size;
    inline-size: 100%;
  }

  /*
    Grid layout:
    - 1 col default (< 744px): 3 rows = shows items 1-3
    - 2 cols (744px - 1127px, >= 360px per card): 3 rows = shows items 1-6
    - 3 cols (>= 1128px, >= 360px per card): 3 rows = shows items 1-9
  */
  .recommendations__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* 1 col default: cap at 3 rows (3 items) */
  .recommendations__grid > .recommendation-card:nth-child(n+4) {
    display: none;
  }

  /* Container query for 2 columns (2 * 360px + 24px gap = 744px) */
  @container (min-width: 744px) {
    .recommendations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .recommendations__grid > .recommendation-card:nth-child(-n+6) {
      display: flex;
    }
    .recommendations__grid > .recommendation-card:nth-child(n+7) {
      display: none;
    }
  }

  /* Container query for 3 columns (3 * 360px + 2 * 24px gap = 1128px) */
  @container (min-width: 1128px) {
    .recommendations__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .recommendations__grid > .recommendation-card:nth-child(-n+9) {
      display: flex;
    }
    .recommendations__grid > .recommendation-card:nth-child(n+10) {
      display: none;
    }
  }

  /* Media query fallbacks */
  @media (min-width: 820px) {
    .recommendations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .recommendations__grid > .recommendation-card:nth-child(-n+6) {
      display: flex;
    }
    .recommendations__grid > .recommendation-card:nth-child(n+7) {
      display: none;
    }
  }

  @media (min-width: 1240px) {
    .recommendations__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .recommendations__grid > .recommendation-card:nth-child(-n+9) {
      display: flex;
    }
    .recommendations__grid > .recommendation-card:nth-child(n+10) {
      display: none;
    }
  }

  .recommendation-card {
    display: flex;
    inline-size: 100%;
    direction: rtl;
  }

  .recommendation-card :global(.glass-card) {
    inline-size: 100%;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
  }

  .recommendation-card__button {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: start;
    gap: 1rem;
    padding: 0;
  }

  .recommendation-card__image-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: clamp(12rem, 16vw, 14.5rem);
    padding: 0;
    background: transparent;
    border: none;
    overflow: hidden;
  }

  .recommendation-card__image-frame img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
  }

  .recommendation-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.25rem;
    color: var(--color-ink-soft);
    font-size: var(--fs-small);
    transition: color var(--dur-fast) var(--ease-soft);
  }

  .recommendation-card__button:hover .recommendation-card__footer {
    color: var(--color-ink);
  }

  .recommendation-card__hint {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .recommendation-card__icon {
    font-size: 1rem;
    opacity: 0.7;
    transition: transform var(--dur-fast) var(--ease-soft), opacity var(--dur-fast) var(--ease-soft);
  }

  .recommendation-card__button:hover .recommendation-card__icon {
    transform: translate(-2px, -2px);
    opacity: 1;
  }

  /* Link button under grid */
  .recommendations__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-block-start: clamp(2rem, 4vh, 3.5rem);
  }

  /* ============================================================
     MODAL DIALOG — Fixed Header, Dedicated Scrollable Image Area
     ============================================================ */
  .recommendations-modal {
    inline-size: min(90vw, 560px);
    block-size: min(58vh, 450px);
    max-block-size: min(58vh, 450px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 1.5rem 5rem rgba(34, 51, 42, 0.32);
    overflow: hidden;
    position: fixed;
    inset: 0;
  }

  .recommendations-modal::backdrop {
    background: rgba(34, 51, 42, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .recommendations-modal__dialog-inner {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    position: relative;
    overflow: hidden;
  }

  .recommendations-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
    border-block-end: 1px solid rgba(0, 0, 0, 0.07);
    background: var(--color-paper);
    z-index: 10;
    flex-shrink: 0;
  }

  .recommendations-modal__counter {
    color: var(--color-mist);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .recommendations-modal__header-nav {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .recommendations-modal__header-btn {
    border: 1px solid var(--color-glass-stroke);
    border-radius: 50%;
    background: var(--color-glass);
    color: var(--color-ink);
    cursor: pointer;
    min-inline-size: 38px;
    min-block-size: 38px;
  }

  .recommendations-modal__close {
    border: 1px solid var(--color-glass-stroke);
    border-radius: 50%;
    background: var(--color-glass);
    color: var(--color-ink);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-soft), transform var(--dur-fast) var(--ease-soft);
  }

  .recommendations-modal__close:hover {
    background: rgba(255, 255, 255, 0.85);
    transform: scale(1.06);
  }

  .recommendations-modal__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 1.25rem clamp(1rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    scrollbar-width: thin;
    scrollbar-color: var(--color-mist) transparent;
  }

  .recommendations-modal__body::-webkit-scrollbar {
    width: 6px;
  }
  .recommendations-modal__body::-webkit-scrollbar-thumb {
    background: var(--color-mist);
    border-radius: 4px;
  }

  .recommendations-modal__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    inline-size: 100%;
    max-inline-size: 480px;
    margin: auto;
  }

  .recommendations-modal__img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(34, 51, 42, 0.08);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }

  .recommendations-modal__img.is-loaded {
    opacity: 1;
  }

  .recommendations-modal__nav--side {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    z-index: 20;
    border: 1px solid var(--color-glass-stroke);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--color-ink);
    box-shadow: 0 4px 16px rgba(34, 51, 42, 0.14);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-soft), transform var(--dur-fast) var(--ease-soft), box-shadow var(--dur-fast) var(--ease-soft);
  }

  .recommendations-modal__nav--side:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(34, 51, 42, 0.2);
  }

  .recommendations-modal__nav--next {
    inset-inline-end: 1rem;
  }

  .recommendations-modal__nav--prev {
    inset-inline-start: 1rem;
  }

  :global(html.dialog-open),
  :global(body.dialog-open) {
    overflow: hidden !important;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 639px) {
    .recommendations__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .recommendations-modal {
      inline-size: 94vw;
      block-size: min(60dvh, 410px);
      max-block-size: min(60dvh, 410px);
      border-radius: calc(var(--radius-card) - 6px);
    }

    .recommendations-modal__header {
      padding: 0.65rem 0.85rem;
    }

    .recommendations-modal__body {
      padding: 1rem 0.65rem;
    }

    .recommendations-modal__header-nav {
      display: flex;
    }

    .recommendations-modal__nav--side {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recommendations-modal::backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
