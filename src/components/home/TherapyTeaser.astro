---
/**
 * TherapyTeaser — one modality card on the home triptych.
 * Full-viewport section with alternating image/text layout.
 */
import SoftImage from '../ui/SoftImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'therapies'>;
  /** Alternate layout (image on left) */
  flip?: boolean;
}

const { entry, flip = false } = Astro.props;
const { title, kicker, accent, hero_image, teaser_image, summary } = entry.data;
const slug = entry.slug;
---

<a
  href={`/${slug}`}
  id={`teaser-${slug}`}
  class:list={['therapy-teaser', flip && 'therapy-teaser--flip']}
  data-theme={accent}
  aria-labelledby={`therapy-title-${slug}`}
>
  <div class="accent-overlay" aria-hidden="true"></div>

  <div class="teaser-inner container">
    <!-- Image -->
    <div class="teaser-image" data-parallax data-speed="0.92" data-reveal>
      <SoftImage id={hero_image} aspect="4/3" tint transitionName={`therapy-img-${slug}`} />
    </div>

    <!-- Text -->
    <div class="teaser-text" data-reveal>
      <p class="teaser-kicker">{kicker}</p>
      <h2 id={`therapy-title-${slug}`} class="teaser-title">{title}</h2>
      <p class="teaser-summary">{summary}</p>
      {teaser_image && (
        <div class="teaser-secondary">
          <SoftImage id={teaser_image} aspect="4/3" />
        </div>
      )}
      <span class="teaser-cta link-underline">
        להמשך קריאה ←
      </span>
    </div>
  </div>
</a>

<style>
  .therapy-teaser {
    position: relative;
    display: flex;
    min-block-size: auto;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-section);
    text-decoration: none;
    color: inherit;
  }

  .accent-overlay {
    position: absolute;
    inset: 0;
    background: var(--accent, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .teaser-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
    z-index: 1;
    /* Give content vertical breathing room within the 100svh container */
    padding-block: clamp(3rem, 6vh, 5rem);
  }

  /* Flip: swap columns */
  .therapy-teaser--flip .teaser-inner {
    direction: ltr; /* temporarily flip direction for visual mirror */
  }
  .therapy-teaser--flip .teaser-inner > * {
    direction: rtl; /* restore RTL for content inside */
  }

  .teaser-kicker {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-ink-soft);
    margin-block-end: 0.5rem;
  }

  .teaser-title {
    font-size: var(--fs-h1);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-display);
    margin-block-end: 1rem;
  }

  .teaser-summary {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    margin-block-end: 1.5rem;
  }

  .teaser-secondary {
    margin-block: 1.5rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .teaser-cta {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .teaser-inner {
      grid-template-columns: 1fr;
      direction: rtl !important;
    }
    .teaser-inner > * { direction: rtl !important; }

.teaser-image {
      height: 20vh;
      overflow: hidden;
      border-radius: var(--radius-card);
    }
  }
</style>
