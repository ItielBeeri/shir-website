---
/** One modality on the home triptych. */
import SoftImage from '../ui/SoftImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'therapies'>;
  /** Mirror the columns, so consecutive teasers alternate. */
  flip?: boolean;
}

const { entry, flip = false } = Astro.props;
const { title, kicker, accent, hero_image, teaser_image, summary } = entry.data;
const slug = entry.slug;
---

<a
  href={`/${slug}`}
  id={`teaser-${slug}`}
  class:list={['therapy-teaser', flip && 'therapy-teaser--flip']}
  data-theme={accent}
  aria-labelledby={`therapy-title-${slug}`}
>
  <div class="accent-overlay" aria-hidden="true"></div>

  <div class="teaser-inner container">
    <div class="teaser-image" data-parallax data-speed="0.92" data-reveal>
      <!--
        260px on mobile, not 92vw: .teaser-image is capped at 20vh there, so
        the 4/3 figure is sized by its height and lands near 220px wide
        whatever the phone's width.
      -->
      <SoftImage
        id={hero_image}
        aspect="4/3"
        tint
        sizes="(max-width: 767px) 260px, 540px"
        transitionName={`therapy-img-${slug}`}
      />
    </div>

    <div class="teaser-text" data-reveal>
      <p class="teaser-kicker">{kicker}</p>
      <h2 id={`therapy-title-${slug}`} class="teaser-title">{title}</h2>
      <p class="teaser-summary">{summary}</p>
      {teaser_image && (
        <div class="teaser-secondary">
          <SoftImage id={teaser_image} aspect="4/3" sizes="(max-width: 767px) 92vw, 540px" />
        </div>
      )}
      <span class="teaser-cta link-underline">
        להמשך קריאה ←
      </span>
    </div>
  </div>
</a>

<style>
  .therapy-teaser {
    position: relative;
    display: flex;
    min-block-size: auto;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-section);
    text-decoration: none;
    color: inherit;
  }

  .accent-overlay {
    position: absolute;
    inset: 0;
    background: var(--accent, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .teaser-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 4vh, 3rem);
  }

  /* Mirrors the two columns; the children restore RTL for their content. */
  .therapy-teaser--flip .teaser-inner {
    direction: ltr;
  }
  .therapy-teaser--flip .teaser-inner > * {
    direction: rtl;
  }

  .teaser-kicker {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-ink-soft);
    margin-block-end: 0.5rem;
  }

  .teaser-title {
    font-size: var(--fs-h1);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-display);
    margin-block-end: 1rem;
  }

  .teaser-summary {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    margin-block-end: 1.5rem;
    white-space: pre-line;
  }

  .teaser-secondary {
    margin-block: 1.5rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .teaser-cta {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .teaser-inner {
      grid-template-columns: 1fr;
      direction: rtl !important;
    }
    .teaser-inner > * { direction: rtl !important; }

.teaser-image {
      height: 20vh;
      overflow: hidden;
      border-radius: var(--radius-card);
    }
  }
</style>
