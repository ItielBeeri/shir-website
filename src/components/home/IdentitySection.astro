---
/**
 * IdentitySection — unified intro for homepage.
 * Combines the former Hero + IntroBlock into one cohesive section.
 *
 * Layout (desktop):
 *   ┌─────────────────────────────────────────────────────────┐
 *   │                     [portrait]                          │
 *   │                                                         │
 *   │   שיר אמיתי                                             │
 *   │   ─────────────────────                                 │
 *   │   מרחב לטיפול בגוף, נפש וקול                          │
 *   │                                                         │
 *   │   [intro paragraph text flowing naturally...]           │
 *   │                                                         │
 *   │   פסיכותרפיה גופנית · שיאצו · פתיחת קול                │
 *   │                                                         │
 *   │   [קרא עוד עליי ←]                                      │
 *   └─────────────────────────────────────────────────────────┘
 *
 * On mobile: portrait top, then title/text, then chips, then CTA.
 * No full-viewport hero barrier — content visible immediately.
 */
import SoftImage from '../ui/SoftImage.astro';

interface Props {
  title: string;
  subtitle: string;
  modalityTagline: string;
  portraitImageId: string;
  introParagraph1: string;
  introParagraph2: string;
  ctaLabel: string;
  ctaHref: string;
  therapySlugs?: string[];
}

const {
  title,
  subtitle,
  modalityTagline,
  portraitImageId,
  introParagraph1,
  introParagraph2,
  ctaLabel,
  ctaHref,
  therapySlugs = [],
} = Astro.props;

const modalities = modalityTagline.split('·').map((s) => s.trim());
---

<section class="identity" aria-labelledby="identity-title">
  <div class="identity-inner container">

    <!-- col: portrait (desktop left / mobile centre) -->
    <a href={ctaHref} class="identity-portrait-link" data-parallax data-speed="0.92">
      <SoftImage id={portraitImageId} aspect="3/4" loading="eager" />
    </a>

    <!-- col: title block (desktop right / mobile top) -->
    <div class="identity-text">
      <a href={ctaHref} class="identity-text-link">
        <h1 id="identity-title" class="identity-title">{title}</h1>
        <p class="identity-subtitle">{subtitle}</p>
        <div class="identity-rule" aria-hidden="true">
          <svg viewBox="0 0 320 12" preserveAspectRatio="none" class="identity-rule-svg">
            <path
              class="rule-path"
              d="M0,6 Q80,0 160,6 Q240,12 320,6"
              fill="none"
              stroke="var(--color-mist)"
              stroke-width="1"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </a>

      <div class="identity-modalities" role="list">
        {modalities.map((m, i) => {
          const slug = therapySlugs[i];
          return (
            <a
              href={slug ? `#teaser-${slug}` : undefined}
              class="identity-chip"
              role="listitem"
              aria-label={slug ? `גלול לחלק ${m}` : undefined}
            >
              {m}
            </a>
          );
        })}
      </div>
    </div>

    <!-- paragraph 1: aside the portrait on desktop; between title and portrait on mobile -->
    <div class="identity-intro-1">
      <a href={ctaHref} class="identity-text-link">
        <p class="identity-intro">
          {introParagraph1}
        </p>
      </a>
    </div>

    <!-- paragraph 2: spans full width below both columns on desktop; below portrait on mobile -->
    <div class="identity-intro-2">
      <a href={ctaHref} class="identity-text-link">
        <p class="identity-intro">
          {introParagraph2}
        </p>
        <span class="identity-cta link-underline">
          {ctaLabel}
          <span aria-hidden="true"> ←</span>
        </span>
      </a>
    </div>

  </div>
</section>

<style>
  .identity {
    padding-block-start: clamp(2rem, 4vh, 3rem);
    padding-block-end: var(--space-section);
  }

  /* ── Desktop grid ──────────────────────────────────────────────────────────
     portrait  │  title + modalities   (row 1)
     portrait  │  paragraph 1          (row 2, portrait spans both rows)
               ┴
               paragraph 2 full width  (row 3, spans both columns)
  ──────────────────────────────────────────────────────────────────────── */
  .identity-inner {
    max-inline-size: 1000px;
    display: grid;
    grid-template-columns: minmax(280px, 380px) 1fr;
    grid-template-areas:
      "text  portrait"
      "para1 portrait"
      "para2    para2";
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: 0.75rem;
    align-items: start;
  }

  .identity-portrait-link {
    grid-area: portrait;
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-soft);
    align-self: stretch;
    max-block-size: 500px;
  }

  .identity-portrait-link:hover {
    transform: scale(1.02);
  }

  .identity-text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .identity-intro-1 {
    grid-area: para1;
  }

  .identity-intro-2 {
    grid-area: para2;
    padding-block-start: 0.5rem;
  }

  /* ── Shared text styles ──────────────────────────────────────────────── */
  .identity-text-link {
    text-decoration: none;
    color: inherit;
  }

  .identity-title {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: clamp(2.4rem, 5.5vw, 5rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: var(--lh-display);
    color: var(--color-ink);
    margin-block: 0 0.25rem;
  }

  .identity-subtitle {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink-soft);
    margin-block: 0 0.5rem;
  }

  .identity-rule {
    inline-size: min(100%, 280px);
    margin-block-end: 0.5rem;
  }

  .identity-rule-svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .rule-path {
    animation: rule-drift 8s ease-in-out infinite alternate;
  }

  @keyframes rule-drift {
    from { d: path("M0,6 Q80,0 160,6 Q240,12 320,6"); }
    to   { d: path("M0,6 Q80,12 160,6 Q240,0 320,6"); }
  }

  .identity-modalities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-block-end: 0.5rem;
  }

  .identity-chip {
    display: inline-flex;
    align-items: center;
    padding-block: 0.4em;
    padding-inline: 1em;
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--color-ink-soft);
    background: var(--color-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--color-glass-stroke);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-soft),
      color var(--dur-fast) var(--ease-soft),
      transform var(--dur-fast) var(--ease-soft);
  }

  .identity-chip[href]:hover,
  .identity-chip[href]:focus-visible {
    background: rgba(255, 255, 255, 0.65);
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  .identity-chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .identity-intro {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    white-space: pre-line;
    margin-block-end: 0.5rem;
  }

  .identity-cta {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  /* ── Mobile ────────────────────────────────────────────────────────────
     title/subtitle/modalities
     paragraph 1
     portrait (centred)
     paragraph 2 + CTA
  ──────────────────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .identity {
      padding-block-end: 5rem;
    }

    .identity-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "text"
        "para1"
        "portrait"
        "para2";
      row-gap: 1rem;
      column-gap: 0;
    }

    .identity-portrait-link {
      max-inline-size: 240px;
      margin-inline: auto;
    }

    .identity-text {
      text-align: center;
      align-items: center;
      gap: 0.5rem;
    }

    .identity-title {
      font-size: clamp(2.4rem, 9vw, 4rem);
    }

    .identity-subtitle {
      font-size: var(--fs-h3);
    }

    .identity-rule {
      margin-inline: auto;
      margin-block-end: 0.25rem;
    }

    .identity-intro {
      text-align: center;
      margin-block-end: 0.25rem;
    }

    .identity-modalities {
      justify-content: center;
      margin-block-end: 0.25rem;
    }

    .identity-intro-1,
    .identity-intro-2 {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule-path {
      animation: none;
    }
    .identity-portrait-link:hover {
      transform: none;
    }
  }
</style>
