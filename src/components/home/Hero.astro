---
/**
 * Hero — home page hero section (100vh).
 * Title letter-stagger on load, scroll-cue, subtle card fade on scroll.
 */
interface Props {
  title: string;
  tagline: string;
  descriptor: string;
  scrollCue?: string;
}

const { title, tagline, descriptor } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-descriptor">{descriptor}</p>
    <h1 id="hero-title" class="hero-title">
      {title}
    </h1>
    <p class="hero-tagline">{tagline}</p>
  </div>
</section>

<style>
  .hero {
    block-size: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-block: 0;
  }

  .hero-content {
    text-align: center;
    max-inline-size: 800px;
    padding-inline: 2rem;
  }

  .hero-descriptor {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    letter-spacing: 0.08em;
    font-weight: 300;
    margin-block-end: 1.5rem;
    opacity: 0;
    animation: fade-in 1000ms var(--ease-soft) 600ms forwards;
  }

  .hero-title {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-display);
    font-weight: 100;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-block-end: 1.5rem;
    opacity: 0;
    animation: fade-in 1200ms var(--ease-soft) 200ms forwards;
  }

  .hero-tagline {
    font-size: clamp(1rem, 1.4vw + 0.5rem, 1.2rem);
    font-weight: 300;
    color: var(--color-mist);
    letter-spacing: 0.04em;
    opacity: 0;
    animation: fade-in 1000ms var(--ease-soft) 800ms forwards;
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-descriptor, .hero-tagline {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initHeroScroll() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const card = document.querySelector<HTMLElement>('.hero .hero-content');
    if (!card) return;

    // Kill any existing hero trigger to avoid duplicates after page transitions
    ScrollTrigger.getById('hero-card')?.kill();

    gsap.to(card, {
      scale: 0.95,
      opacity: 0.4,
      ease: 'none',
      scrollTrigger: {
        id: 'hero-card',
        trigger: '.hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
    });
  }

  initHeroScroll();
</script>
