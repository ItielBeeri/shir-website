---
/**
 * Hero — home page hero section (100svh).
 *
 * Layout (desktop):
 *   ┌─────────────────────────────────────────────┐
 *   │         descriptor (small kicker)           │
 *   │                                             │
 *   │            שיר אמיתי  (giant title)         │
 *   │         ─────────────────────               │  ← decorative rule
 *   │                                             │
 *   │  [פסיכותרפיה גופנית]  [שיאצו]  [פתיחת קול] │  ← modality chips
 *   │                                             │
 *   │            ↓  (animated scroll-to button)   │
 *   └─────────────────────────────────────────────┘
 *
 * Animation notes:
 *   - All entrance animations (fade-up) are driven by GSAP in the <script>
 *     block so there is no CSS opacity:0 fighting a CSS keyframe.
 *   - The breath effect animates ONLY letter-spacing + a gentle opacity
 *     via GSAP .to() that starts after the entrance completes.
 *   - The scroll-hint is a <button> so it is clickable and keyboard-reachable.
 *     It is removed from the a11y tree while visible only as a decorative cue
 *     via aria-hidden; once JS runs it gets aria-label + role restored.
 */
interface Props {
  title: string;
  tagline: string;
  descriptor: string;
  scrollCue?: string;
  /** Therapy slugs in display order — used to wire chip → teaser scroll targets. */
  therapySlugs?: string[];
}

const { title, tagline, descriptor, therapySlugs = [] } = Astro.props;

// Split tagline on "·" to render as individual chips
const modalities = tagline.split('·').map((s) => s.trim());
---

<section class="hero" aria-labelledby="hero-title" id="hero-section">
  <div class="hero-content" id="hero-content">
    <!-- Kicker / descriptor -->
    <p class="hero-descriptor" id="hero-descriptor">{descriptor}</p>

    <!-- Main title with decorative rule -->
    <div class="hero-title-wrap">
      <h1 id="hero-title" class="hero-title">{title}</h1>
      <div class="hero-rule" id="hero-rule" aria-hidden="true">
        <svg viewBox="0 0 320 12" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="hero-rule-svg">
          <path
            class="rule-path"
            d="M0,6 Q80,0 160,6 Q240,12 320,6"
            fill="none"
            stroke="var(--color-mist)"
            stroke-width="1"
            stroke-linecap="round"
          />
        </svg>
      </div>
    </div>

    <!-- Modality chips — buttons that scroll to the corresponding therapy section -->
    <div class="hero-chips" role="list" id="hero-chips">
      {modalities.map((m, i) => {
        const slug = therapySlugs[i];
        return (
          <button
            class="hero-chip"
            role="listitem"
            type="button"
            data-target={slug ? `teaser-${slug}` : undefined}
            aria-label={slug ? `גלול לחלק ${m}` : undefined}
          >
            {m}
          </button>
        );
      })}
    </div>
  </div>

  <!--
    Scroll hint — a button so it is clickable.
    aria-hidden initially; JS restores accessibility label after mount.
    Positioned high enough to clear the ContactPill (~72px tall).
  -->
  <button
    class="scroll-hint"
    id="scroll-hint"
    type="button"
    aria-hidden="true"
    tabindex="-1"
  >
    <svg
      class="scroll-chevron"
      viewBox="0 0 32 32"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      width="36"
      height="36"
      aria-hidden="true"
    >
      <!-- Outer circle -->
      <circle cx="16" cy="16" r="15" stroke="var(--color-mist)" stroke-width="1" opacity="0.5"/>
      <!-- Chevron -->
      <path
        d="M11 13L16 18L21 13"
        stroke="var(--color-ink-soft)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</section>

<style>
  /* ── Section ──────────────────────────────────────────── */
  .hero {
    block-size: 100svh;
    min-block-size: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-block: 0;
    overflow: hidden;
  }

  /* ── Content cluster ──────────────────────────────────── */
  .hero-content {
    text-align: center;
    padding-inline: clamp(1.5rem, 6vw, 5rem);
    /* Slight upward shift for optical centering */
    margin-block-end: 5vh;
  }

  /* ── Descriptor / kicker ──────────────────────────────── */
  .hero-descriptor {
    font-size: var(--fs-body);
    font-weight: 300;
    color: var(--color-ink-soft);
    letter-spacing: 0.1em;
    margin-block-end: clamp(1.8rem, 4vh, 3.5rem);
    /* Start hidden; GSAP handles entrance */
    opacity: 0;
    transform: translateY(12px);
  }

  /* ── Title wrapper ────────────────────────────────────── */
  .hero-title-wrap {
    position: relative;
    display: inline-block;
  }

  /* ── Title ────────────────────────────────────────────── */
  .hero-title {
    font-family: 'Assistant', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-display);
    font-weight: 200;
    color: var(--color-ink);
    letter-spacing: 0.02em;
    line-height: var(--lh-display);
    margin-block-end: 0;
    /* Start hidden; GSAP handles entrance + breath loop */
    opacity: 0;
    transform: translateY(10px);
  }

  /* ── Decorative rule ──────────────────────────────────── */
  .hero-rule {
    inline-size: min(100%, 420px);
    margin-inline: auto;
    margin-block-start: clamp(0.4rem, 1vh, 0.9rem);
    margin-block-end: clamp(1.8rem, 4vh, 3.2rem);
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: center;
  }

  .hero-rule-svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .rule-path {
    animation: rule-drift 8s ease-in-out infinite alternate;
  }

  /* ── Modality chips ───────────────────────────────────── */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1.5vw, 0.9rem);
    justify-content: center;
    align-items: center;
  }

  .hero-chip {
    /* Reset button appearance */
    appearance: none;
    border: 1px solid var(--color-glass-stroke);
    background: var(--color-glass);
    font-family: inherit;

    font-size: var(--fs-hero-tagline);
    font-weight: 300;
    color: var(--color-ink-soft);
    letter-spacing: 0.06em;

    /* Frosted-glass pill */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--radius-pill);
    padding-block: 0.45em;
    padding-inline: 1.1em;

    cursor: pointer;
    /* Smooth hover transition */
    transition:
      background var(--dur-fast) var(--ease-soft),
      border-color var(--dur-fast) var(--ease-soft),
      color var(--dur-fast) var(--ease-soft),
      transform var(--dur-fast) var(--ease-soft);

    /* Start hidden; GSAP handles staggered entrance */
    opacity: 0;
    transform: translateY(10px);
  }

  /* Chip without a target (no slug) — still styled, just not interactive */
  .hero-chip:not([data-target]) {
    cursor: default;
  }

  .hero-chip[data-target]:hover,
  .hero-chip[data-target]:focus-visible {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(255, 255, 255, 0.8);
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  .hero-chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* ── Scroll hint button ───────────────────────────────── */
  .scroll-hint {
    /* Reset button appearance */
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;

    /* Position: above ContactPill.
       ContactPill is ~72px tall + 24px from bottom = ~96px.
       We sit at 6rem (~96px) from bottom — safely clear. */
    position: absolute;
    inset-block-end: clamp(5.5rem, 10vh, 7rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);

    /* Hit target */
    min-inline-size: 48px;
    min-block-size: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    /* Start hidden; GSAP handles entrance */
    opacity: 0;

    /* Focus ring */
    border-radius: 50%;
  }

  .scroll-hint:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .scroll-chevron {
    display: block;
    /* CSS bounce animation — runs continuously */
    animation: chevron-bounce 2.2s ease-in-out infinite;
  }

  /* ── Keyframes ────────────────────────────────────────── */
  @keyframes chevron-bounce {
    0%, 100% { transform: translateY(0);   opacity: 0.6; }
    50%       { transform: translateY(7px); opacity: 1;   }
  }

  @keyframes rule-drift {
    from { d: path("M0,6 Q80,0 160,6 Q240,12 320,6"); }
    to   { d: path("M0,6 Q80,12 160,6 Q240,0 320,6"); }
  }

  /* ── Reduced motion ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-descriptor,
    .hero-chip,
    .hero-rule,
    .scroll-hint {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .scroll-chevron { animation: none; opacity: 0.6; }
    .rule-path { animation: none; }
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 480px) {
    .hero-chips {
      flex-direction: column;
      gap: 0.6rem;
    }
    .hero-chip {
      font-size: 1rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Chip → therapy section scroll ──────────────────── */
    const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);

    const scrollToId = (id: string) => {
      const target = document.getElementById(id);
      if (!target) return;

      const lenis = (window as unknown as Record<string, unknown>).__lenis as
        | { scrollTo: (target: number, opts?: { duration?: number; easing?: (t: number) => number }) => void }
        | undefined;

      const targetY = target.getBoundingClientRect().top + window.scrollY;

      if (lenis) {
        lenis.scrollTo(targetY, { duration: 1.05, easing: easeOutQuart });
      } else {
        window.scrollTo({ top: targetY, behavior: 'smooth' });
      }
    };

    document.querySelectorAll<HTMLButtonElement>('.hero-chip[data-target]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const targetId = chip.dataset.target;
        if (targetId) scrollToId(targetId);
      });
    });

    /* ── Scroll-hint button wiring ───────────────────────── */
    const hint = document.getElementById('scroll-hint');
    if (hint) {
      hint.removeAttribute('aria-hidden');
      hint.setAttribute('tabindex', '0');
      hint.setAttribute('aria-label', 'גלול למטה');

      hint.addEventListener('click', () => {
        const hero = document.getElementById('hero-section');
        const next = hero?.nextElementSibling as HTMLElement | null;
        if (!next) return;
        const targetY = next.getBoundingClientRect().top + window.scrollY;
        const lenis = (window as unknown as Record<string, unknown>).__lenis as
          | { scrollTo: (target: number, opts?: { duration?: number; easing?: (t: number) => number }) => void }
          | undefined;
        if (lenis) {
          lenis.scrollTo(targetY, { duration: 1.05, easing: easeOutQuart });
        } else {
          window.scrollTo({ top: targetY, behavior: 'smooth' });
        }
      });
    }

    if (prefersReducedMotion) return;

    /* ── Entrance sequence (GSAP — no CSS opacity conflict) ─ */
    const title      = document.getElementById('hero-title');
    const descriptor = document.getElementById('hero-descriptor');
    const rule       = document.getElementById('hero-rule');
    const chips      = document.querySelectorAll<HTMLElement>('.hero-chip');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl
      .to(title, { opacity: 1, y: 0, duration: 1.1 }, 0.1)
      .to(descriptor, { opacity: 1, y: 0, duration: 0.9 }, 0.5)
      .to(rule, { opacity: 1, scaleX: 1, duration: 0.8 }, 0.85)
      .to(chips, { opacity: 1, y: 0, duration: 0.8, stagger: 0.12 }, 1.0)
      .to(hint, { opacity: 1, duration: 0.7 }, 1.8);

    /* ── Breathing effect — GSAP yoyo (starts after entrance) ─
       Animates opacity 1 → 0.68 and letter-spacing.
       Using a GSAP tween avoids the CSS animation shorthand
       conflict that caused the title to stay at opacity:0. */
    tl.add(() => {
      if (!title) return;
      gsap.to(title, {
        opacity: 0.68,
        letterSpacing: '0.05em',
        duration: 2.1,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }, '+=0.3');

    /* ── Hero card parallax fade on scroll ───────────────── */
    const card = document.getElementById('hero-content');
    if (card) {
      ScrollTrigger.getById('hero-card')?.kill();
      gsap.to(card, {
        y: -40,
        scale: 0.97,
        opacity: 0.3,
        ease: 'none',
        scrollTrigger: {
          id: 'hero-card',
          trigger: '#hero-section',
          start: 'top top',
          end: 'bottom top',
          scrub: 1.2,
        },
      });
    }

    /* ── Scroll hint fades out as hero leaves ────────────── */
    if (hint) {
      ScrollTrigger.getById('hero-hint')?.kill();
      gsap.to(hint, {
        opacity: 0,
        y: 10,
        ease: 'none',
        scrollTrigger: {
          id: 'hero-hint',
          trigger: '#hero-section',
          start: 'top top',
          end: '18% top',
          scrub: true,
        },
      });
    }
  }

  initHero();
</script>
