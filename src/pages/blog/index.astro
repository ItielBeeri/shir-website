---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ContactPill from '../../components/layout/ContactPill.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import SoftImage from '../../components/ui/SoftImage.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BreathDivider from '../../components/ui/BreathDivider.astro';
import ScrollReveal from '../../components/ui/ScrollReveal.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allPosts[0];
const rest     = allPosts.slice(1);

function formatDate(date: Date): string {
  return date.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="בלוג | שיר אמיתי"
  description="מחשבות, רשימות ומסעות — פוסטים על גוף, נפש וקול."
>
  <Header />

  <main id="main">
    <!-- Hero band -->
    <section class="blog-hero container" aria-labelledby="blog-h1">
      <div data-reveal>
        <p class="text-kicker">מחשבות, רשימות, מסעות</p>
        <h1 id="blog-h1" class="blog-title">בלוג</h1>
      </div>
    </section>

    {featured && (
      <section class="blog-featured container" aria-label="הפוסט האחרון">
        <ScrollReveal>
          <a href={`/blog/${featured.slug}`} class="featured-link">
            <GlassCard hover>
              <div class="featured-inner">
                {featured.data.cover && (
                  <div class="featured-image">
                    <SoftImage id={featured.data.cover} aspect="16/9" />
                  </div>
                )}
                <div class="featured-text">
                  <time class="text-small text-mist" datetime={featured.data.date.toISOString()}>
                    {formatDate(featured.data.date)}
                  </time>
                  <h2 class="featured-post-title">{featured.data.title}</h2>
                  <p class="featured-excerpt">{featured.data.excerpt}</p>
                </div>
              </div>
            </GlassCard>
          </a>
        </ScrollReveal>
      </section>
    )}

    {rest.length > 0 && (
      <section class="blog-grid-section container" aria-label="כל הפוסטים">
        <SectionHeading kicker="כל הכתבות" title="הארכיון" />
        <div class="posts-grid" data-reveal data-stagger="60">
          {rest.map((post) => (
            <a href={`/blog/${post.slug}`} class="post-tile" data-reveal>
              <GlassCard hover>
                {post.data.cover && (
                  <div class="post-thumb">
                    <SoftImage id={post.data.cover} aspect="16/9" />
                  </div>
                )}
                <time class="text-small text-mist" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-excerpt">{post.data.excerpt}</p>
                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.slice(0, 2).map((t) => (
                      <span class="tag-chip">{t}</span>
                    ))}
                  </div>
                )}
              </GlassCard>
            </a>
          ))}
        </div>
      </section>
    )}

    {allPosts.length === 0 && (
      <div class="container blog-empty">
        <GlassCard>
          <p>פוסטים יתווספו בקרוב.</p>
        </GlassCard>
      </div>
    )}
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  .blog-hero {
    padding-block-start: clamp(6rem, 15vh, 10rem);
    padding-block-end: var(--space-block);
  }
  .blog-title {
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: var(--ls-display);
    color: var(--color-ink);
    margin-block-start: 0.5rem;
  }

  .blog-featured { padding-block: var(--space-block); }
  .featured-link { display: block; }

  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .featured-post-title {
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 0.5rem 0.75rem;
  }

  .featured-excerpt {
    font-size: var(--fs-body);
    color: var(--color-ink-soft);
    line-height: var(--lh-body);
  }

  .blog-grid-section { padding-block: var(--space-section); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block-start: var(--space-block);
  }

  .post-tile { display: block; }

  .post-thumb { margin: calc(-1 * clamp(1.5rem, 4vw, 2.5rem)); margin-block-end: 1rem; border-radius: var(--radius-card) var(--radius-card) 0 0; overflow: hidden; }

  .post-title {
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 0.4rem 0.5rem;
  }

  .post-excerpt {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-block-start: 0.75rem; }
  .tag-chip { font-size: 0.8rem; padding: 0.15rem 0.6rem; border-radius: var(--radius-pill); background: var(--color-glass); border: 1px solid var(--color-glass-stroke); color: var(--color-ink-soft); }

  .blog-empty { padding-block: var(--space-section); }
  .blog-empty p { color: var(--color-mist); text-align: center; }

  @media (max-width: 767px) {
    .featured-inner, .posts-grid { grid-template-columns: 1fr; }
  }
</style>
