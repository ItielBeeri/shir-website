---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ContactPill from '../../components/layout/ContactPill.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import SoftImage from '../../components/ui/SoftImage.astro';
import BreathDivider from '../../components/ui/BreathDivider.astro';
import { getCollection } from 'astro:content';
import { sortBlogPosts } from '../../lib/blog';

const allPosts = sortBlogPosts(
  (await getCollection('blog')).filter((p) => !p.data.draft),
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="בלוג | שיר אמיתי"
  description="מחשבות, רשימות ומסעות — פוסטים על גוף, נפש וקול."
>
  <Header />

  <main id="main">
    <section class="blog-hero container" aria-labelledby="blog-h1">
      <div data-reveal>
        <h1 id="blog-h1" class="blog-title">בלוג</h1>
      </div>
    </section>

    {allPosts.length > 0 ? (
      <section class="blog-grid-section container" aria-label="כל הפוסטים">
        <div class="posts-grid" data-reveal data-stagger="60">
          {allPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="post-tile" data-reveal>
              <GlassCard hover>
                {post.data.cover && (
                  <div class="post-thumb">
                    <SoftImage id={post.data.cover} aspect="16/9" />
                  </div>
                )}
                <time class="text-small text-mist" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-excerpt">
                  <span class="post-excerpt__text">{post.data.excerpt}</span>
                </p>
                <div class="post-tags">
                  {post.data.tags.slice(0, 3).map((t) => (
                    <span class="tag-chip">{t}</span>
                  ))}
                </div>
              </GlassCard>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <div class="container blog-empty">
        <GlassCard>
          <p>פוסטים יתווספו בקרוב.</p>
        </GlassCard>
      </div>
    )}
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  .blog-hero {
    padding-block-start: clamp(4rem, 10vh, 7rem);
    padding-block-end: calc(var(--space-block) * 0.5);
  }
  .blog-title {
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: var(--ls-display);
    color: var(--color-ink);
  }

  .blog-grid-section { padding-block: calc(var(--space-block) * 0.5) var(--space-section); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 3rem;
  }

  .post-tile { display: block; }
  .post-tile .glass-card { block-size: 100%; }

  .post-thumb { margin: calc(-1 * clamp(1.5rem, 4vw, 2.5rem)); margin-block-end: 1rem; border-radius: var(--radius-card) var(--radius-card) 0 0; overflow: hidden; }

  .post-title {
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 0.3rem 0.4rem;
  }

  .post-excerpt {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    block-size: calc(2 * 1.6em);
    overflow: hidden;
  }

  .post-excerpt__text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-block-start: 0.6rem; min-block-size: 1.6rem; }
  .tag-chip { font-size: 0.75rem; padding: 0.1rem 0.5rem; border-radius: var(--radius-pill); background: var(--color-glass); border: 1px solid var(--color-glass-stroke); color: var(--color-ink-soft); }

  .blog-empty { padding-block: var(--space-section); }
  .blog-empty p { color: var(--color-mist); text-align: center; }

  @media (max-width: 767px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
