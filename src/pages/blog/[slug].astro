---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ContactPill from "../../components/layout/ContactPill.astro";
import SoftImage from "../../components/ui/SoftImage.astro";
import BreathDivider from "../../components/ui/BreathDivider.astro";
import { getCollection, render } from "astro:content";
import { blogPostingSchema, jsonLd } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString("he-IL", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);
---

<BaseLayout
  title={`${post.data.title} | שיר אמיתי`}
  description={post.data.excerpt}
>
  <Fragment slot="head">
    <Fragment
      set:html={jsonLd(
        blogPostingSchema({
          title: post.data.title,
          excerpt: post.data.excerpt,
          date: post.data.date,
          slug: post.slug,
        }),
      )}
    />
  </Fragment>

  <Header />

  <main id="main">
    <!-- Hero: fixed cover that content scrolls over -->
    <div class="post-shell">
      {
        post.data.cover && (
          <div class="post-cover">
            <SoftImage id={post.data.cover} aspect="21/9" loading="eager" />
          </div>
        )
      }

      <div class="post-content">
        <section class="post-hero" aria-labelledby="post-h1">
          <div class="container">
            <div class="post-header">
              <div class="post-meta">
                <time class="post-date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span class="meta-dot" aria-hidden="true">·</span>
                <span class="post-reading-time">{readingTime} דקות קריאה</span>
              </div>
              <h1 id="post-h1" class="post-title">{post.data.title}</h1>
              {
                post.data.tags.length > 0 && (
                  <ul class="post-tags" aria-label="תגיות">
                    {post.data.tags.map((t) => (
                      <li class="tag-chip">{t}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          </div>
        </section>

        <!-- Reading column -->
        <section class="post-body container" aria-label="גוף הכתבה">
          <div class="prose">
            <Content components={{ SoftImage }} />
          </div>
        </section>

        <!-- Back to blog -->
        <div class="container post-back">
          <a href="/blog" class="link-underline">→ חזרה לבלוג</a>
        </div>
      </div>
    </div>
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  /* --- Fixed-cover scroll reveal --- */
  .post-shell {
    position: relative;
  }

  .post-cover {
    position: sticky;
    inset-block-start: 0;
    z-index: 0;
    inline-size: 100vw;
    margin-inline-start: calc(50% - 50vw);
    block-size: min(80vh, 640px);
    overflow: hidden;
  }
  .post-cover :global(.soft-image) {
    block-size: 100%;
    inline-size: 100%;
    border-radius: 0;
    margin: 0;
  }

  /* Content scrolls up and covers the sticky image */
  .post-content {
    position: relative;
    z-index: 1;
    border-start-start-radius: var(--radius-card);
    border-start-end-radius: var(--radius-card);
    margin-block-start: calc(min(80vh, 640px) * -0.12);
    box-shadow: 0 -20px 50px rgba(92, 110, 101, 0.1);
    /* ensure it is always tall enough to fully cover the cover image */
    min-block-size: 80vh;
    isolation: isolate;
  }

  /*
   * Own backdrop that mirrors the site's fixed watercolor field.
   * It is opaque enough to hide the sticky cover image behind it,
   * yet reproduces the same watercolor + paper wash the rest of the
   * site shows - so the running text always sits on the watercolor,
   * never on the cover photo. A translucent paper wash keeps text
   * readable exactly like GlassCard surfaces elsewhere.
   */
  .post-content::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(253, 250, 244, 0.78), rgba(253, 250, 244, 0.78)),
      url("/img/bg/background.jpg");
    background-size: cover, cover;
    background-position: center, center;
    /* attachment: fixed pins the watercolor to the viewport like the
       site's BackgroundField, while the box clips it to the content */
    background-attachment: fixed, fixed;
    border-radius: inherit;
  }

  @media (max-width: 767px) {
    .post-cover {
      block-size: min(56vh, 420px);
    }
    .post-content {
      margin-block-start: calc(min(56vh, 420px) * -0.1);
    }
  }

  .post-hero {
    padding-block-start: var(--space-section);
    padding-block-end: var(--space-section);
  }

  .post-header {
    max-inline-size: 68ch;
    margin-inline: auto;
    text-align: start;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-block-end: 1.1rem;
  }

  .post-date,
  .post-reading-time {
    font-size: var(--fs-small);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--color-mist);
  }
  .meta-dot {
    color: var(--color-mist);
    opacity: 0.6;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.25;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-block-start: 1.5rem;
  }
  .tag-chip {
    font-size: var(--fs-small);
    letter-spacing: var(--ls-caps);
    color: var(--color-mist);
    padding-inline-end: 0.9rem;
    position: relative;
  }
  .tag-chip::before {
    content: "#";
    color: var(--accent, var(--color-teal));
    margin-inline-end: 0.15rem;
    opacity: 0.8;
  }

  .post-body {
    padding: 0;
    padding-block-end: var(--space-section);
    max-inline-size: 72ch;
  }

  @media (max-width: 767px) {
    .post-body {
      padding-inline: clamp(1rem, 5vw, 4rem);
    }
  }

  /* Drop cap */
  /* .prose :global(p:first-of-type::first-letter) {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 500;
    line-height: 0.8;
    float: inline-start;
    margin-inline-end: 0.1em;
    margin-block-end: 0;
    color: var(--color-ink);
  } */

  .prose {
    font-size: var(--fs-body);
    line-height: 1.85;
    color: var(--color-ink-soft);
  }
  .prose :global(h2) {
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 2.5rem 1rem;
  }
  .prose :global(h3) {
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 2rem 0.75rem;
  }
  .prose :global(p) {
    margin-block-end: 1.25rem;
  }
  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 300;
    border-inline-start: 3px solid var(--accent, var(--color-teal));
    padding-inline-start: 1.25rem;
    color: var(--color-ink-soft);
    margin-block: 2rem;
  }
  .prose :global(ol),
  .prose :global(ul) {
    list-style-position: inside;
    padding-inline-start: 0;
    margin-block-end: 1rem;
  }
  .prose :global(li) {
    margin-block-end: 0.4rem;
  }

  .post-back {
    padding-block-end: var(--space-section);
    font-size: var(--fs-small);
  }
</style>
