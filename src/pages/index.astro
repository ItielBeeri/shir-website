---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactPill from '../components/layout/ContactPill.astro';
import IdentitySection from '../components/home/IdentitySection.astro';
import TherapyTeaser from '../components/home/TherapyTeaser.astro';
import BlogTeaser from '../components/home/BlogTeaser.astro';
import RecommendationsSection from '../components/home/RecommendationsSection.astro';
import BreathDivider from '../components/ui/BreathDivider.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import { getCollection } from 'astro:content';
import { loadToml } from '../lib/content';
import { z } from 'zod';
import { personSchema, localBusinessSchema, jsonLd } from '../lib/seo';

const homeSchema = z.object({
  hero:    z.object({ title: z.string(), subtitle: z.string(), tagline: z.string(), descriptor: z.string(), scroll_cue: z.string() }),
  intro:   z.object({ portrait: z.string(), cta_label: z.string(), cta_href: z.string(), paragraph_1: z.string(), paragraph_2: z.string() }),
  teasers: z.object({ blog: z.object({ label: z.string(), cta_label: z.string(), cta_href: z.string() }) }),
  closing: z.object({ enabled: z.boolean(), line: z.string() }),
});
const siteSchema = z.object({
  contact: z.object({
    whatsapp_url: z.string(), whatsapp_label: z.string(),
    phone_href: z.string(), phone_display: z.string(), phone_label: z.string(),
    email_href: z.string(), email_label: z.string(),
  }),
});
const imagesSchema = z.record(z.string(), z.object({ file: z.string(), preview: z.string().optional(), alt: z.string() }));
const recommendationsSchema = z.object({
  recommendations: z.array(z.object({
    id: z.string().min(1),
    transcription: z.string().min(1),
    relatedTherapies: z.array(z.string()).default([]),
    author_label: z.string().optional(),
    date_label: z.string().optional(),
    approved: z.boolean().default(false),
    active: z.boolean().default(true),
  })),
});

const home   = loadToml('pages/home.toml', homeSchema);
const { contact } = loadToml('site.toml', siteSchema);
const images = loadToml('images.toml', imagesSchema);
const recommendationData = loadToml('recommendations.toml', recommendationsSchema);
const recommendations = recommendationData.recommendations.map((item) => {
  if (!images[item.id]) throw new Error(`Recommendation ${item.id} has no registered image`);
  return item;
}).filter((item) => item.approved && item.active);

const therapies = (await getCollection('therapies')).sort((a, b) => a.data.order - b.data.order);
const blogPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="שיר אמיתי | פסיכותרפיה גופנית, שיאצו ופתיחת קול"
  description="שיר אמיתי — מרחב לטיפול בגוף, נפש וקול. פסיכותרפיה גופנית, שיאצו ופתיחת קול בפרדס חנה ובזום."
>
  <Fragment slot="head">
    <Fragment set:html={jsonLd(personSchema())} />
    <Fragment set:html={jsonLd(localBusinessSchema())} />
  </Fragment>

  <Header />

  <main id="main">
    <!-- A. Identity section — unified portrait + title + intro -->
    <IdentitySection
      title={home.hero.title}
      subtitle={home.hero.subtitle}
      modalityTagline={home.hero.tagline}
      portraitImageId={home.intro.portrait}
      introParagraph1={home.intro.paragraph_1}
      introParagraph2={home.intro.paragraph_2}
      ctaLabel={home.intro.cta_label}
      ctaHref={home.intro.cta_href}
      therapySlugs={therapies.map((t) => t.slug)}
    />

    <!-- B. Therapy triptych -->
    {therapies.map((therapy, i) => (
      <>
        <BreathDivider />
        <TherapyTeaser entry={therapy} flip={i % 2 === 1} />
      </>
    ))}

    <BreathDivider />

    <RecommendationsSection recommendations={recommendations} images={images} />

    <BreathDivider />

    <!-- D. Blog teaser -->
    <BlogTeaser
      posts={blogPosts}
      label={home.teasers.blog.label}
      ctaLabel={home.teasers.blog.cta_label}
      ctaHref={home.teasers.blog.cta_href}
    />

    <!-- E. Closing / contact -->
    {home.closing.enabled && (
      <section class="closing-section container" aria-labelledby="closing-heading">
        <ScrollReveal>
          <SectionHeading title="יצירת קשר" center id="closing-heading" />
          <div class="closing-cta">
            <!-- WhatsApp → Phone → Email (§5.4) -->
            <CTAButton
              href={contact.whatsapp_url}
              label={contact.whatsapp_label}
              icon="whatsapp"
              variant="primary"
              external
            />
            <CTAButton
              href={contact.phone_href}
              label={`${contact.phone_label} · ${contact.phone_display}`}
              icon="phone"
              variant="secondary"
            />
            <CTAButton
              href={contact.email_href}
              label={contact.email_label}
              icon="mail"
              variant="tertiary"
            />
          </div>
        </ScrollReveal>
      </section>
    )}
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<script>
  import '@/scripts/home-scroll';
</script>

<style>
  .closing-section {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing-line {
    font-family: 'Heebo', 'Arial Hebrew', system-ui, sans-serif;
    font-size: var(--fs-h2);
    font-weight: 200;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    /* Generous breathing room before the contact block */
    margin-block-end: clamp(2rem, 5vh, 4rem);
  }

  .closing-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block-start: 2rem;
  }
</style>
