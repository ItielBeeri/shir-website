---
/**
 * _design - component preview route (hidden, noindex).
 * Shows every shared component in every state.
 * Excluded from sitemap.xml and robots.txt.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BreathDivider from '../components/ui/BreathDivider.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import Icon from '../components/ui/Icon.astro';
import RecommendationsSection from '../components/home/RecommendationsSection.astro';
import { loadToml } from '../lib/content';
import { loadRecommendations } from '../lib/recommendations';
import { z } from 'zod';

const images = loadToml('images.toml', z.record(z.string(), z.object({ file: z.string(), alt: z.string() })));
const recommendations = loadRecommendations();
---

<BaseLayout
  title="Design Preview | שיר אמיתי"
  description="Component preview route - not for public use."
  noindex
>
  <Header />

  <main id="main" class="design-page container">
    <h1 class="design-title">Design System Preview</h1>
    <p class="design-subtitle">רק לשימוש פנימי - כל הרכיבים בכל המצבים</p>

    <!-- ── Typography ── -->
    <section class="design-section" aria-labelledby="typo-heading">
      <h2 id="typo-heading" class="design-section-title">Typography</h2>
      <GlassCard>
        <p class="text-display">Display - שיר אמיתי</p>
        <p class="text-h1">H1 - פסיכותרפיה גופנית</p>
        <p class="text-h2">H2 - מרחב לטיפול בגוף ונפש</p>
        <p class="text-h3">H3 - שיאצו ופתיחת קול</p>
        <p class="text-body">Body - גוף הטקסט הרגיל של האתר. מסביר, מזמין, רגוע.</p>
        <p class="text-small text-mist">Small / Mist - תיאור משני, כיתוב תאריך</p>
        <p class="text-kicker">Kicker - Heebo · קיקר</p>
        <blockquote>ציטטה - Heebo 300 גדול עם מאגר שמאלי</blockquote>
      </GlassCard>
    </section>

    <!-- ── Color Palette ── -->
    <section class="design-section" aria-labelledby="colors-heading">
      <h2 id="colors-heading" class="design-section-title">Color Tokens</h2>
      <div class="swatch-grid">
        {[
          ['--color-ink',      '#22332a', 'ink'],
          ['--color-ink-soft', '#4a5c51', 'ink-soft'],
          ['--color-mist',     '#7a8a82', 'mist'],
          ['--color-paper',    '#fdfaf4', 'paper'],
          ['--color-cream',    '#f5ecda', 'cream'],
          ['--color-sand',     '#e8d4a8', 'sand'],
          ['--color-peach',    '#f3c9bb', 'peach'],
          ['--color-rose',     '#e9b8c2', 'rose'],
          ['--color-lavender', '#c9bde0', 'lavender'],
          ['--color-teal',     '#a6d4c8', 'teal'],
          ['--color-seafoam',  '#bfe0d3', 'seafoam'],
        ].map(([token, hex, name]) => (
          <div class="swatch">
            <div class="swatch-color" style={`background: ${hex}`}></div>
            <p class="swatch-name">{name}</p>
            <p class="swatch-token">{token}</p>
            <p class="swatch-hex">{hex}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── GlassCard ── -->
    <section class="design-section" aria-labelledby="glass-heading">
      <h2 id="glass-heading" class="design-section-title">GlassCard</h2>
      <div class="design-row">
        <GlassCard>Default glass card</GlassCard>
        <GlassCard hover>Hover-enabled glass card (try hovering)</GlassCard>
      </div>
    </section>

    <section class="design-section" aria-labelledby="design-recommendations-heading">
      <h2 id="design-recommendations-heading" class="design-section-title">המלצות</h2>
      <RecommendationsSection recommendations={recommendations} images={images} />
    </section>

    <!-- ── Buttons ── -->
    <section class="design-section" aria-labelledby="btns-heading">
      <h2 id="btns-heading" class="design-section-title">CTAButton</h2>
      <div class="design-row">
        <CTAButton href="#" label="שליחת הודעה בוואטסאפ" icon="whatsapp" variant="primary" />
        <CTAButton href="#" label="התקשרות · 052-520-1162" icon="phone" variant="secondary" />
        <CTAButton href="#" label="שליחת מייל" icon="mail" variant="tertiary" />
      </div>
    </section>

    <!-- ── SectionHeading ── -->
    <section class="design-section" aria-labelledby="sh-heading">
      <h2 id="sh-heading" class="design-section-title">SectionHeading</h2>
      <GlassCard>
        <SectionHeading kicker="קיקר" title="כותרת סעיף" />
      </GlassCard>
      <GlassCard>
        <SectionHeading kicker="קיקר ממורכז" title="כותרת ממורכזת" center />
      </GlassCard>
    </section>

    <!-- ── BreathDivider ── -->
    <section class="design-section" aria-labelledby="bd-heading">
      <h2 id="bd-heading" class="design-section-title">BreathDivider</h2>
    </section>
    <BreathDivider />
    <div class="design-section">
      <BreathDivider flip />
    </div>

    <!-- ── Icons ── -->
    <section class="design-section" aria-labelledby="icons-heading">
      <h2 id="icons-heading" class="design-section-title">Icons</h2>
      <GlassCard>
        <div class="icon-grid">
          {['phone','whatsapp','mail','facebook','menu','close','arrow-forward','arrow-back','arrow-down','external','quote','share'].map((name) => (
            <div class="icon-cell">
              <Icon name={name} label={name} size={24} />
              <span class="icon-name">{name}</span>
            </div>
          ))}
        </div>
      </GlassCard>
    </section>

    <!-- ── Themes ── -->
    <section class="design-section" aria-labelledby="themes-heading">
      <h2 id="themes-heading" class="design-section-title">Themes</h2>
      <div class="design-row">
        {['default','psychotherapy','shiatsu','voice'].map((theme) => (
          <div data-theme={theme} style="padding: 1.5rem; border-radius: var(--radius-card); border: 1px solid var(--color-glass-stroke); background: var(--color-glass);">
            <p class="text-kicker" style="color: var(--accent)">{theme}</p>
            <p class="text-small">accent: {theme}</p>
            <BreathDivider />
          </div>
        ))}
      </div>
    </section>

    <!-- ── ScrollReveal demo ── -->
    <section class="design-section" aria-labelledby="reveal-heading">
      <h2 id="reveal-heading" class="design-section-title">ScrollReveal</h2>
      <ScrollReveal stagger={80}>
        <GlassCard>כרטיס 1 (יגלה עם גלילה)</GlassCard>
        <GlassCard>כרטיס 2</GlassCard>
        <GlassCard>כרטיס 3</GlassCard>
      </ScrollReveal>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .design-page {
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .design-title {
    font-size: var(--fs-h1);
    font-weight: 300;
    color: var(--color-ink);
  }

  .design-subtitle {
    color: var(--color-mist);
    font-size: var(--fs-small);
  }

  .design-section-title {
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink-soft);
    margin-block-end: 1.5rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--color-glass-stroke);
  }

  .design-section { display: flex; flex-direction: column; gap: 1rem; }

  .design-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
  }

  .swatch-color {
    block-size: 60px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.06);
    margin-block-end: 0.5rem;
  }

  .swatch-name  { font-size: 0.85rem; font-weight: 600; color: var(--color-ink); }
  .swatch-token { font-size: 0.7rem; color: var(--color-mist); font-family: monospace; }
  .swatch-hex   { font-size: 0.7rem; color: var(--color-mist); }

  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 1.5rem;
  }

  .icon-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
  }

  .icon-name {
    font-size: 0.7rem;
    color: var(--color-mist);
    text-align: center;
  }
</style>
