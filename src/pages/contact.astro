---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactPill from '../components/layout/ContactPill.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import BreathDivider from '../components/ui/BreathDivider.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import Icon from '../components/ui/Icon.astro';
import { loadToml } from '../lib/content';
import { socialLinks, socialSchema } from '../lib/social';
import { z } from 'zod';

const contactPageSchema = z.object({
  hero:     z.object({ kicker: z.string(), title: z.string(), intro: z.string() }),
  location: z.object({ title: z.string(), address: z.string(), note: z.string() }),
});
const siteSchema = z.object({
  contact: z.object({
    whatsapp_url: z.string(), whatsapp_label: z.string(),
    phone_href: z.string(), phone_display: z.string(), phone_label: z.string(),
    email_href: z.string(), email_display: z.string(), email_label: z.string(),
  }),
  social: socialSchema,
});

const page   = loadToml('pages/contact.toml', contactPageSchema);
const site   = loadToml('site.toml', siteSchema);
const contact = site.contact;
const social = socialLinks(site.social);
---

<BaseLayout
  title="יצירת קשר | שיר אמיתי"
  description={page.hero.intro}
>
  <Header />

  <main id="main">
    <section class="contact-intro container" aria-labelledby="contact-h1">
      <div class="contact-intro-content">
        <p class="text-kicker">{page.hero.kicker}</p>
        <h1 id="contact-h1" class="contact-title">{page.hero.title}</h1>
        <p class="contact-intro-text">{page.hero.intro}</p>
      </div>
    </section>

    <section class="contact-actions container" aria-label="אפשרויות יצירת קשר">
      <ScrollReveal>
        <GlassCard>
          <!-- WhatsApp → phone → email: source order is the channel priority. -->
          <div class="contact-group">
            <CTAButton
              href={contact.whatsapp_url}
              label={contact.whatsapp_label}
              icon="whatsapp"
              variant="primary"
              external
              analytics={{ event: 'contact_click', channel: 'whatsapp', placement: 'contact_page' }}
            />
            <CTAButton
              href={contact.phone_href}
              label={`${contact.phone_label} · ${contact.phone_display}`}
              icon="phone"
              variant="secondary"
              analytics={{ event: 'contact_click', channel: 'phone', placement: 'contact_page' }}
            />
            <CTAButton
              href={contact.email_href}
              label={contact.email_display}
              icon="mail"
              variant="tertiary"
              analytics={{ event: 'contact_click', channel: 'email', placement: 'contact_page' }}
            />
          </div>

          <div class="contact-social">
            {social.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="link-underline social-link"
                aria-label={`${link.label} - נפתח בטאב חדש`}
                data-an-event="outbound_click"
                data-an-cta-label={link.event}
                data-an-placement="contact_page"
              >
                <Icon name={link.icon} decorative size={16} />
                {link.label}
              </a>
            ))}
          </div>
        </GlassCard>
      </ScrollReveal>
    </section>

    <section class="contact-location container" aria-labelledby="location-heading">
      <ScrollReveal>
        <GlassCard>
          <h2 id="location-heading" class="location-title">{page.location.title}</h2>
          <p class="location-address">{page.location.address}</p>
          <p class="location-note">{page.location.note}</p>
        </GlassCard>
      </ScrollReveal>
    </section>
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  .contact-intro {
    padding-block-start: clamp(3rem, 6vh, 5rem);
    padding-block-end: var(--space-block);
  }

  .contact-intro-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-inline-size: 55ch;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: var(--lh-display);
    color: var(--color-ink);
    margin-block: 0.25rem 0.5rem;
  }

  .contact-intro-text {
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--color-ink-soft);
  }

  .contact-actions {
    padding-block: var(--space-block);
    max-inline-size: 560px;
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* The card is sized to fit the email address and phone number unbroken;
     wrapping is released only on the narrowest phones. */
  .contact-group :global(.cta-btn span) {
    white-space: nowrap;
  }

  .contact-social {
    margin-block-start: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    font-size: var(--fs-small);
  }

  @media (max-width: 520px) {
    .contact-group :global(.cta-btn span) {
      white-space: normal;
    }
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 44px;
    padding-block: 0.5rem;
    color: var(--color-ink-soft);
  }

  /* The sweep underline belongs under the words, not under the tap padding
     that carries the row to 44px. */
  .social-link::after { inset-block-end: 0.5rem; }

  .social-link :global(svg) { flex: none; }

  .contact-location {
    padding-block: var(--space-block);
    max-inline-size: 560px;
  }

  .location-title {
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  .location-address {
    font-size: var(--fs-body);
    color: var(--color-ink-soft);
    margin-block-end: 0.5rem;
  }

  .location-note {
    font-size: var(--fs-small);
    color: var(--color-mist);
  }
</style>
