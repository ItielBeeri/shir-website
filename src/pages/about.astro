---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactPill from '../components/layout/ContactPill.astro';
import SoftImage from '../components/ui/SoftImage.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BreathDivider from '../components/ui/BreathDivider.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import { getCollection, render } from 'astro:content';
import { z } from 'zod';
import { loadToml } from '../lib/content';
import { socialLinks, socialSchema } from '../lib/social';

const [aboutEntry] = await getCollection('about');
const { title, intro, portrait_image, more_links } = aboutEntry.data;
const { Content } = await render(aboutEntry);

const site = loadToml('site.toml', z.object({ social: socialSchema }));
const social = socialLinks(site.social);
// A missing placeholder still lists the links, after the sentence.
const [linksBefore, linksAfter = ''] = more_links.includes('{קישורים}')
  ? more_links.split('{קישורים}', 2)
  : [`${more_links} `, ''];
// ListFormat supplies the Hebrew joiners (", " and " ו") so the list grows
// with site.toml rather than with this file.
let linkIndex = 0;
const linkParts = new Intl.ListFormat('he', { type: 'conjunction' })
  .formatToParts(social.map((link) => link.label))
  .map((part) => (part.type === 'element' ? { link: social[linkIndex++] } : { text: part.value }));

const therapies = (await getCollection('therapies')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="אודות | שיר אמיתי"
  description={intro}
>
  <Header />

  <main id="main">
    <section class="about-intro container" aria-labelledby="about-h1">
      <div class="prose">
        <div class="about-opening">
          <SoftImage id={portrait_image} aspect="3/4" float="end" floatWidth="340" />
          <h1 id="about-h1" class="about-title">{title}</h1>
          <div class="about-rule" aria-hidden="true">
            <svg viewBox="0 0 320 12" preserveAspectRatio="none" class="hero-rule-svg">
              <path
                class="rule-path"
                d="M0,6 Q80,0 160,6 Q240,12 320,6"
                fill="none"
                stroke="var(--color-rule)"
                stroke-width="1"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <p class="about-intro-paragraph">{intro}</p>
        </div>
        <Content components={{ SoftImage }} />
        {more_links.trim() && (
          <!-- One line: whitespace between these expressions would render as spaces inside the sentence. -->
          <p class="about-more-links">{linksBefore}{linkParts.map((part) => part.link ? (
            <a href={part.link.href} target="_blank" rel="noopener" aria-label={`${part.link.label} - נפתח בטאב חדש`} data-an-event="outbound_click" data-an-cta-label={part.link.event} data-an-placement="about_text">{part.link.label}</a>
          ) : part.text)}{linksAfter}</p>
        )}
      </div>
    </section>

    <BreathDivider />

    <section class="about-therapies-cta container" aria-labelledby="therapies-cta-heading">
      <ScrollReveal>
        <SectionHeading title="המסלולים שלי" center id="therapies-cta-heading" />
        <div class="therapies-cta-grid">
          {therapies.map((therapy) => (
            <a
              href={`/${therapy.slug}`}
              class="therapy-cta-card"
              data-an-event="content_open"
              data-an-content-type="therapy"
              data-an-item={therapy.slug}
              data-an-placement="about_cards"
            >
              <div class="therapy-cta-image">
                <SoftImage id={therapy.data.hero_image} aspect="4/3" tint sizes="(max-width: 767px) 92vw, 360px" />
              </div>
              <div class="therapy-cta-content">
                <p class="therapy-cta-kicker">{therapy.data.kicker}</p>
                <h3 class="therapy-cta-title">{therapy.data.title}</h3>
                <span class="link-underline therapy-cta-link">
                  להמשך קריאה ←
                </span>
              </div>
            </a>
          ))}
        </div>
      </ScrollReveal>
    </section>
  </main>

  <BreathDivider />
  <Footer />
  <ContactPill />
</BaseLayout>

<style>
  /*
   * A reading measure, not the full container: body copy at 1240px runs past
   * comfortable line length. Sized to land near the blog post's 72ch once the
   * container's own padding is taken off.
   */
  .about-intro {
    padding-block-start: clamp(3rem, 6vh, 5rem);
    padding-block-end: var(--space-section);
    max-inline-size: 104ch;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: var(--lh-display);
    color: var(--color-ink);
    margin-block: 0.25rem 0.5rem;
  }

  .about-rule {
    inline-size: min(100%, 280px);
    margin-block-end: 0.5rem;
  }

  .hero-rule-svg {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .rule-path {
    animation: rule-drift 8s ease-in-out infinite alternate;
  }

  @keyframes rule-drift {
    from { d: path("M0,6 Q80,0 160,6 Q240,12 320,6"); }
    to   { d: path("M0,6 Q80,12 160,6 Q240,0 320,6"); }
  }

  .about-intro-paragraph {
    font-size: var(--fs-h3);
    font-weight: 300;
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    white-space: pre-line;
    margin-block-end: 1.25rem;
  }

  /*
   * A layout-invisible wrapper: the portrait, the title and the opening lines
   * lay out in .prose exactly as if it were not here, so the float still
   * escapes and the body copy still wraps around it.
   */
  .about-opening {
    display: contents;
  }

  /*
   * Matches SoftImage's own float breakpoint. With no room beside the text the
   * portrait would otherwise open the page ahead of its title; here it becomes
   * a flex container only to reorder the photo below the opening lines, still
   * above the body copy.
   */
  @media (max-width: 768px), (max-inline-size: 600px) {
    .about-opening {
      display: flex;
      flex-direction: column;
    }

    .about-opening > :global(.soft-image) {
      order: 1;
      /* Stacked it is read at portrait size, not stretched to the measure:
         across the full width of a tablet it becomes a screen-high billboard
         between the opening lines and the body copy. */
      inline-size: min(100%, 340px);
      margin-inline: auto;
    }
  }

  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-ink-soft);
    display: flow-root;
  }

  .prose :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--color-ink);
    margin-block: 2.5rem 1rem;
  }

  .prose :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin-block: 1.5rem 0.75rem;
  }

  .prose :global(p) {
    margin-block-end: 1.25rem;
  }

  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 300;
    line-height: 1.55;
    border-inline-start: 3px solid var(--accent, var(--color-teal));
    padding-inline-start: 1.25rem;
    color: var(--color-ink-soft);
    margin-block: 2rem;
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-inline-start: 1.5rem;
    margin-block-end: 1.25rem;
  }

  /* Inline links need a mark beyond colour (WCAG 1.4.1): they inherit it. */
  .about-more-links a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .about-more-links a:hover {
    color: var(--color-ink);
  }

  .prose :global(li) {
    margin-block-end: 0.5rem;
  }

  .prose :global(img) {
    margin-block: 2rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .prose :global(figure:not(.soft-image)) {
    margin-block: 2rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* A floated body image must not run past its own section. */
  .prose :global(h2) {
    clear: both;
  }

  .about-therapies-cta {
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-block);
  }

  .therapies-cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 1200px;
  }

  .therapy-cta-card {
    display: block;
    background: var(--color-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border: 1px solid var(--color-glass-stroke);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft);
  }

  .therapy-cta-card:hover,
  .therapy-cta-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .therapy-cta-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .therapy-cta-image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .therapy-cta-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-soft);
  }

  .therapy-cta-card:hover .therapy-cta-image :global(img) {
    transform: scale(1.05);
  }

  .therapy-cta-content {
    padding: 1.25rem;
  }

  .therapy-cta-kicker {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    margin-block-end: 0.35rem;
  }

  .therapy-cta-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  .therapy-cta-link {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .therapies-cta-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule-path {
      animation: none;
    }
  }
</style>
