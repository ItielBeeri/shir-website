{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore.sh :/src :/public :/scripts :/astro.config.mjs :/tsconfig.json :/package.json :/pnpm-lock.yaml :/vercel.json :/.nvmrc",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true,
      "content-preview": true
    }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/_opt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
